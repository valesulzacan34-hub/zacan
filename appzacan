      const allowedUnits = getAllowedUnits();

      let allActions = [];

      savedReports.forEach(rep => {
        if (!allowedUnits.includes(rep.unit)) return;
        let storeMatch = !storeFilter || rep.unit === storeFilter;

        rep.nonConformities?.forEach((nc, i) => {
          let dueDate = nc.date || '';
          let matchDate = true;
          if (dueDate && dueDate !== 'Não definida') {
            let parts = dueDate.split('/');
            let iso = `${parts[2]}-${parts[1]}-${parts[0]}`;
            if (startFilter && iso < startFilter) matchDate = false;
            if (endFilter && iso > endFilter) matchDate = false;
          }
          let actId = `${rep.id}_nc_${i}`;
          let statusObj = actionCustomStatus[actId] || 'Pendente';
          let priorityObj = actionCustomPriority[actId] || 'Urgente';

          if (matchDate && storeMatch) {
            allActions.push({ 
              unit: rep.unit, title: nc.title, action: nc.action || 'Não descrita', 
              date: dueDate || 'Indefinida', rawDate: dueDate, chatId: actId, 
              status: statusObj, priority: priorityObj, fullReportId: rep.id, type: 'nc', index: i, isManual: false
            });
          }
        });

        rep.maintenanceOrders?.forEach((om, i) => {
          let dueDate = om.date || '';
          let matchDate = true;
          if (dueDate && dueDate !== 'Não definida') {
            let parts = dueDate.split('/');
            let iso = `${parts[2]}-${parts[1]}-${parts[0]}`;
            if (startFilter && iso < startFilter) matchDate = false;
            if (endFilter && iso > endFilter) matchDate = false;
          }
          let actId = `${rep.id}_om_${i}`;
          let statusObj = actionCustomStatus[actId] || 'Pendente';
          let priorityObj = actionCustomPriority[actId] || 'Urgente';

          if (matchDate && storeMatch) {
            allActions.push({ 
              unit: rep.unit, title: `Manutenção: ${om.equipment}`, action: om.action || 'Não descrito', 
              date: dueDate || 'Indefinida', rawDate: dueDate, chatId: actId, 
              status: statusObj, priority: priorityObj, fullReportId: rep.id, type: 'om', index: i, isManual: false
            });
          }
        });
      });

      manualActionsList.forEach((act, i) => {
        if (!allowedUnits.includes(act.unit)) return;
        let storeMatch = !storeFilter || act.unit === storeFilter;
        let matchDate = true;
        if (act.rawDate) {
          if (startFilter && act.rawDate < startFilter) matchDate = false;
          if (endFilter && act.rawDate > endFilter) matchDate = false;
        }

        let statusObj = actionCustomStatus[act.id] || 'Pendente';
        let priorityObj = actionCustomPriority[act.id] || 'Urgente';

        if (matchDate && storeMatch) {
          allActions.push({
            unit: act.unit, title: act.title, action: act.action,
            date: act.date, rawDate: act.rawDate, chatId: act.id,
            status: statusObj, priority: priorityObj, fullReportId: null, type: act.type || 'avulso', index: i, isManual: true
          });
        }
      });

      return allActions.filter(act => {
        let isDone = act.status.toLowerCase().includes('concluído');
        let tabMatch = (currentActionsTab === 'completed') ? isDone : !isDone;
        let statusMatch = !statusFilter || act.status === statusFilter;
        let priorityMatch = !priorityFilter || act.priority === priorityFilter;
        let typeMatch = !actionTypeFilter || act.type === actionTypeFilter;
        return tabMatch && statusMatch && priorityMatch && typeMatch;
      });
    }

    function renderCentralizedActions() {
      const container = document.getElementById("centralized-actions-list");
      const trashBtn = document.getElementById("btn-trash-actions");
      if (trashBtn && currentUser?.role === 'admin') {
        trashBtn.classList.remove("hidden");
        document.getElementById("trash-count").innerText = trashActionsList.length;
      }

      if (!container) return;
      container.innerHTML = "";
      const allowedUnits = getAllowedUnits();
      const storeFilter = document.getElementById("filter-action-store")?.value || "";

      let counts = { pending: 0, progress: 0, completed: 0 };

      savedReports.forEach(rep => {
        if (!allowedUnits.includes(rep.unit)) return;
        let storeMatch = !storeFilter || rep.unit === storeFilter;
        if (!storeMatch) return;

        rep.nonConformities?.forEach((nc, i) => {
          let s = actionCustomStatus[`${rep.id}_nc_${i}`] || 'Pendente';
          if (s.toLowerCase().includes('concluído')) counts.completed++;
          else if (s.toLowerCase().includes('andamento')) counts.progress++;
          else counts.pending++;
        });

        rep.maintenanceOrders?.forEach((om, i) => {
          let s = actionCustomStatus[`${rep.id}_om_${i}`] || 'Pendente';
          if (s.toLowerCase().includes('concluído')) counts.completed++;
          else if (s.toLowerCase().includes('andamento')) counts.progress++;
          else counts.pending++;
        });
      });

      manualActionsList.forEach(act => {
        if (!allowedUnits.includes(act.unit)) return;
        let storeMatch = !storeFilter || act.unit === storeFilter;
        if (!storeMatch) return;

        let s = actionCustomStatus[act.id] || 'Pendente';
        if (s.toLowerCase().includes('concluído')) counts.completed++;
        else if (s.toLowerCase().includes('andamento')) counts.progress++;
        else counts.pending++;
      });

      document.getElementById("counter-pending").innerText = counts.pending;
      document.getElementById("counter-progress").innerText = counts.progress;
      document.getElementById("counter-completed").innerText = counts.completed;

      let filteredActions = getFilteredActionsList();

      filteredActions.sort((a, b) => {
        let parseDate = (d) => {
          if (!d || d === 'Indefinida' || d === 'Não definida') return new Date('2099-12-31');
          if (d.includes('-')) return new Date(d);
          if (d.includes('/')) return new Date(d.split('/').reverse().join('-'));
          return new Date('2099-12-31');
        };
        return parseDate(a.rawDate || a.date) - parseDate(b.rawDate || b.date);
      });

      if (filteredActions.length === 0) {
        container.innerHTML = `<div class="p-8 text-center bg-white rounded-xl border text-stone-400 text-xs">Nenhum plano de ação encontrado nesta aba/filtro.</div>`;
        return;
      }

      filteredActions.forEach(act => {
        let atrasoHtml = "";
        let isDone = act.status.toLowerCase().includes('concluído');
        if (!isDone && act.rawDate && act.rawDate !== 'Indefinida' && act.rawDate !== 'Não definida') {
          let parts = act.rawDate.includes('-') ? act.rawDate.split('-') : act.rawDate.split('/').reverse();
          let dueIso = `${parts[0]}-${parts[1].padStart(2, '0')}-${parts[2].padStart(2, '0')}`;
          let todayIso = new Date().toISOString().split('T')[0];
          if (dueIso < todayIso) {
            let diffTime = Math.abs(new Date(todayIso) - new Date(dueIso));
            let diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            atrasoHtml = `<span class="bg-rose-100 text-rose-800 font-bold px-1.5 py-0.5 rounded text-[10px]">⚠️ ${diffDays}d atraso</span>`;
          }
        }

        let statusOptions = actionStatuses.map(st => `<option value="${st.name}" ${act.status === st.name ? 'selected' : ''}>${st.name}</option>`).join("");
        let currentStatusObj = actionStatuses.find(s => s.name === act.status) || { color: 'bg-white border-stone-200' };

        let priorityOptions = actionPriorities.map(pr => `<option value="${pr.name}" ${act.priority === pr.name ? 'selected' : ''}>${pr.name}</option>`).join("");
        let currentPriorityObj = actionPriorities.find(p => p.name === act.priority) || { style: 'bg-stone-200 text-stone-800 font-semibold' };

        let adminDeleteBtn = currentUser?.role === 'admin' ? `
          <button onclick="deleteActionPlan('${act.chatId}', '${act.fullReportId}', '${act.type}', ${act.index}, ${act.isManual})" class="text-rose-600 hover:text-rose-800 p-1 font-bold" title="Excluir Plano de Ação">🗑️</button>
        ` : '';

        const card = document.createElement("div");
        card.className = `p-4 rounded-xl border shadow-sm flex flex-col gap-2.5 text-xs ${currentStatusObj.color}`;
        card.innerHTML = `
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <div class="flex items-center gap-2 flex-wrap">
              <input type="checkbox" value="${act.chatId}" ${selectedActionIds.has(act.chatId) ? 'checked' : ''} onchange="toggleActionSelection('${act.chatId}')" class="action-select-item rounded text-cb-bordo focus:ring-0">
              <span class="font-bold text-sm text-cb-bordo uppercase">${act.unit}</span>
              <span class="text-stone-500 font-medium">📅 ${act.date}</span>
              <select onchange="updateActionPriority('${act.chatId}', this.value)" class="border rounded px-2 py-0.5 text-[10px] ${currentPriorityObj.style} focus:outline-none cursor-pointer">
                ${priorityOptions}
              </select>
              ${atrasoHtml}
            </div>
            <div class="flex items-center gap-2">
              <select onchange="updateActionStatus('${act.chatId}', this.value, '${act.type}')" class="border rounded px-2.5 py-1 text-xs font-bold bg-white shadow-sm cursor-pointer">
                ${statusOptions}
              </select>
              <button id="btn-chat-${act.chatId}" onclick="openChatModal('${act.chatId}', '${act.fullReportId}', '${act.type}', ${act.index}, ${act.isManual ? 'true' : 'false'})" class="relative px-3 py-1 bg-white text-cb-bordo font-bold rounded shadow-sm border border-stone-200 hover:bg-stone-50 transition">
                💬 Chat & Detalhes
                <span id="chat-dot-${act.chatId}" class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-rose-500 rounded-full border-2 border-white hidden"></span>
              </button>
              ${adminDeleteBtn}
            </div>
          </div>
          <div class="text-stone-800 text-sm leading-relaxed pt-1 border-t border-stone-200/60">
            <strong>${act.title}</strong> — <span class="text-stone-700">${act.action}</span>
          </div>`;
        container.appendChild(card);
      });

      listenToAllChats();
    }

    function openChatModal(chatId, reportId, type, index, isManual = false) {
      activeChatActionId = chatId;
      if (unreadChatMessages[chatId]) {
        delete unreadChatMessages[chatId];
        localStorage.setItem("CB_UNREAD_CHAT_MSGS", JSON.stringify(unreadChatMessages));
        updateNotificationBadgeCount();
      }

      const detailsContainer = document.getElementById("chat-action-details");
      detailsContainer.innerHTML = "";

      let orientacaoManutencao = (type === 'om') ? `
        <div class="p-2.5 bg-amber-100 border border-amber-300 rounded-lg text-amber-900 font-bold flex items-center gap-2">
          <span>⚠️ <strong>Atenção:</strong> Fazer 3 orçamentos e enviar para aprovação.</span>
        </div>` : '';

      let photoUrlDisplay = '';
      if (isManual) {
        const manualAct = manualActionsList.find(a => a.id === chatId);
        if (manualAct) {
          document.getElementById("chat-modal-title").innerText = manualAct.title;
          document.getElementById("chat-modal-subtitle").innerText = `${manualAct.unit} • Prazo: ${manualAct.date}`;
          if (manualAct.photoUrl) {
            photoUrlDisplay = `<div class="mt-2"><span class="block font-bold mb-1">Foto anexada:</span><img src="${manualAct.photoUrl}" onclick="openImageViewer('${manualAct.photoUrl}')" class="h-28 w-auto rounded-lg border object-cover cursor-pointer hover:opacity-90"></div>`;
          }
          detailsContainer.innerHTML = `
            ${orientacaoManutencao}
            <div><strong>Descrição / Ação:</strong> ${manualAct.action}</div>
            ${photoUrlDisplay}
          `;
        }
      } else {
        const rep = savedReports.find(r => r.id === reportId);
        if (rep) {
          let itemData = type === 'nc' ? rep.nonConformities?.[index] : rep.maintenanceOrders?.[index];
          if (itemData) {
            document.getElementById("chat-modal-title").innerText = type === 'nc' ? itemData.title : `Manutenção: ${itemData.equipment}`;
            document.getElementById("chat-modal-subtitle").innerText = `${rep.unit} • Prazo: ${itemData.date}`;

            if (itemData.photoUrl) {
              photoUrlDisplay = `<div class="mt-2"><span class="block font-bold mb-1">Foto anexada no Checklist:</span><img src="${itemData.photoUrl}" onclick="openImageViewer('${itemData.photoUrl}')" class="h-28 w-auto rounded-lg border object-cover cursor-pointer hover:opacity-90"></div>`;
            }

            detailsContainer.innerHTML = `
              ${orientacaoManutencao}
              <div><strong>Descrição / Ação:</strong> ${itemData.action || itemData.defect || 'Não especificada'}</div>
              ${photoUrlDisplay}
            `;
          }
        }
      }

      document.getElementById("chat-modal").classList.remove("hidden");
      loadChatMessages(chatId);
      document.getElementById(`chat-dot-${chatId}`)?.classList.add("hidden");
    }

    function toggleChatModal() {
      document.getElementById("chat-modal").classList.add("hidden");
      activeChatActionId = null;
      renderCentralizedActions();
    }

    function openImageViewer(url) {
      document.getElementById("viewer-img").src = url;
      document.getElementById("image-viewer-modal").classList.remove("hidden");
    }

    async function sendChatAttachment(event) {
      const file = event.target.files[0];
      if (!file || !activeChatActionId || !isFirebaseReady) return;

      try {
        const fileData = await compressImageFile(file, 1024, 0.7);
        let isImage = file.type.startsWith('image/');

        db.collection("chats").doc(activeChatActionId).collection("messages").add({
          text: fileData, 
          sender: currentUser.name, 
          seen: false, 
          isAttachment: true,
          fileType: isImage ? 'image' : 'file',
          fileName: file.name,
          time: new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }), 
          createdAt: firebase.firestore.FieldValue.serverTimestamp()
        }).then(() => {
          event.target.value = '';
        });
      } catch (err) {
        console.error("Erro ao enviar anexo:", err);
      }
    }

    function loadChatMessages(chatId) {
      if (!isFirebaseReady) return;
      db.collection("chats").doc(chatId).collection("messages").orderBy("createdAt", "asc").onSnapshot(snapshot => {
        const container = document.getElementById("chat-messages-container");
        container.innerHTML = "";

        if (snapshot.empty) {
          container.innerHTML = `<div class="text-center text-stone-400 py-6">Nenhuma mensagem ainda. Inicie a conversa.</div>`;
          return;
        }

        snapshot.forEach(doc => {
          const m = doc.data();
          const isMe = m.sender === currentUser.name;

          if (!isMe && !m.seen) {
            db.collection("chats").doc(chatId).collection("messages").doc(doc.id).update({ seen: true });
          }

          const msgDiv = document.createElement("div");
          msgDiv.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'}`;

          let bubbleContent = "";
          if (m.isAttachment) {
            if (m.fileType === 'image') {
              bubbleContent = `<img src="${m.text}" onclick="openImageViewer('${m.text}')" class="max-h-40 rounded-lg cursor-pointer border hover:opacity-90 object-cover mb-1"><a href="${m.text}" download="anexo" class="text-[10px] underline block font-bold">Baixar Imagem</a>`;
            } else {
              bubbleContent = `<a href="${m.text}" download="${m.fileName || 'arquivo'}" class="underline font-bold text-blue-600 block">📄 Baixar: ${m.fileName || 'Arquivo'}</a>`;
            }
          } else {
            bubbleContent = `<span>${m.text}</span>`;
          }

          msgDiv.innerHTML = `
            <div class="max-w-[80%] p-2.5 rounded-xl ${isMe ? 'bg-cb-bordo text-white' : 'bg-stone-200 text-stone-800'}">
              <span class="block text-[9px] font-bold opacity-75 mb-0.5">${m.sender}</span>
              ${bubbleContent}
            </div>
            <div class="flex items-center gap-1 mt-0.5">
              <span class="text-[9px] text-stone-400">${m.time || ''}</span>
              ${isMe ? `<span class="text-[9px] font-bold ${m.seen ? 'text-emerald-600' : 'text-stone-400'}">${m.seen ? '✓✓ Visto' : '✓ Enviado'}</span>` : ''}
            </div>`;
          container.appendChild(msgDiv);
        });
        container.scrollTop = container.scrollHeight;
      });
    }

    function sendChatMessage() {
      const input = document.getElementById("chat-input-msg");
      const text = input.value.trim();
      if (!text || !activeChatActionId || !isFirebaseReady) return;
      db.collection("chats").doc(activeChatActionId).collection("messages").add({
        text: text, sender: currentUser.name, seen: false, time: new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }), createdAt: firebase.firestore.FieldValue.serverTimestamp()
      }).then(() => input.value = "");
    }

    // 📅 Agenda & Calendário
    function changeCalendarView(view) {
      currentCalendarView = view;
      document.getElementById("btn-view-month").className = `px-3 py-1.5 font-bold rounded transition ${view === 'month' ? 'bg-cb-bordo text-white' : 'bg-stone-200 text-stone-700'}`;
      document.getElementById("btn-view-week").className = `px-3 py-1.5 font-bold rounded transition ${view === 'week' ? 'bg-cb-bordo text-white' : 'bg-stone-200 text-stone-700'}`;
      document.getElementById("btn-view-day").className = `px-3 py-1.5 font-bold rounded transition ${view === 'day' ? 'bg-cb-bordo text-white' : 'bg-stone-200 text-stone-700'}`;
      renderAgendaCalendar();
    }

    function navigateCalendar(dir) {
      if (dir === 0) {
        currentCalendarDate = new Date();
      } else {
        if (currentCalendarView === 'month') {
          currentCalendarDate.setMonth(currentCalendarDate.getMonth() + dir);
        } else if (currentCalendarView === 'week') {
          currentCalendarDate.setDate(currentCalendarDate.getDate() + (dir * 7));
        } else if (currentCalendarView === 'day') {
          currentCalendarDate.setDate(currentCalendarDate.getDate() + dir);
        }
      }
      renderAgendaCalendar();
    }

    function normalizeDateToISO(dateString) {
      if (!dateString || dateString === 'Não definida' || dateString === 'Indefinida') return null;
      if (dateString.includes('-')) return dateString.split('T')[0];
      if (dateString.includes('/')) {
        let parts = dateString.split(',')[0].trim().split('/');
        if (parts.length === 3) return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
      }
      return null;
    }

    function renderAgendaCalendar() {
      const gridContainer = document.getElementById("calendar-grid-container");
      const titleEl = document.getElementById("calendar-period-title");
      if (!gridContainer) return;
      gridContainer.innerHTML = "";

      let storeSelection = document.getElementById("filter-agenda-store")?.value || "GERAL";
      if (currentUser?.role === 'gerente' && currentUser.units && currentUser.units.length > 0) {
        storeSelection = currentUser.units[0];
      }

      let allEvents = [];

      calendarEvents.forEach(ev => {
        let isoDate = normalizeDateToISO(ev.date || ev.displayDate);
        if (isoDate) {
          allEvents.push({
            ...ev,
            date: isoDate
          });
        }
      });

      savedReports.forEach(rep => {
        if (currentUser?.role === 'gerente' && rep.unit !== storeSelection) return;

        rep.nonConformities?.forEach((nc, i) => {
          let isoDate = normalizeDateToISO(nc.date);
          if (isoDate) {
            allEvents.push({
              id: `rep_nc_${rep.id}_${i}`,
              title: `[Ação] ${nc.title}`,
              date: isoDate,
              time: '09:00',
              timeEnd: '10:00',
              store: rep.unit,
              scope: 'INDIVIDUAL',
              desc: nc.action || 'Não descrita',
              type: 'action'
            });
          }
        });

        rep.maintenanceOrders?.forEach((om, i) => {
          let isoDate = normalizeDateToISO(om.date);
          if (isoDate) {
            allEvents.push({
              id: `rep_om_${rep.id}_${i}`,
              title: `[Manutenção] ${om.equipment}`,
              date: isoDate,
              time: '10:00',
              timeEnd: '11:00',
              store: rep.unit,
              scope: 'INDIVIDUAL',
              desc: om.action || om.defect || 'Sem descrição',
              type: 'maintenance'
            });
          }
        });
      });

      manualActionsList.forEach(act => {
        if (currentUser?.role === 'gerente' && act.unit !== storeSelection) return;
        let isoDate = normalizeDateToISO(act.rawDate || act.date);
        if (isoDate) {
          allEvents.push({
            id: `act_manual_${act.id}`,
            title: `[Plano] ${act.title}`,
            date: isoDate,
            time: '14:00',
            timeEnd: '15:00',
            store: act.unit,
            scope: 'INDIVIDUAL',
            desc: act.action,
            type: 'action'
          });
        }
      });

      let filteredEvents = allEvents.filter(ev => {
        if (storeSelection === 'GERAL') return ev.scope === 'GERAL';
        return ev.scope === 'GERAL' || ev.store === storeSelection;
      });

      let year = currentCalendarDate.getFullYear();
      let month = currentCalendarDate.getMonth();
      const monthNames = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];

      if (currentCalendarView === 'month') {
        titleEl.innerText = `${monthNames[month]} de ${year}`;
        let firstDayIndex = new Date(year, month, 1).getDay();
        let totalDays = new Date(year, month + 1, 0).getDate();

        let table = document.createElement("div");
        table.className = "grid grid-cols-7 text-xs text-center border-stone-200";

        ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'].forEach(d => {
          let cell = document.createElement("div");
          cell.className = "bg-cb-bordo text-cb-gold font-bold p-2 border-b";
          cell.innerText = d;
          table.appendChild(cell);
        });

        for (let i = 0; i < firstDayIndex; i++) {
          let emptyCell = document.createElement("div");
          emptyCell.className = "bg-stone-50/50 p-2 border-b border-r min-h-[90px]";
          table.appendChild(emptyCell);
        }

        for (let d = 1; d <= totalDays; d++) {
          let dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
          let dayEvents = filteredEvents.filter(e => e.date === dateStr);

          let cell = document.createElement("div");
          cell.className = "bg-white p-1.5 border-b border-r min-h-[90px] flex flex-col justify-start text-left overflow-hidden cursor-pointer hover:bg-stone-50 relative";
          cell.setAttribute('data-date', dateStr);

          cell.ondragover = (e) => e.preventDefault();
          cell.ondrop = (e) => {
            e.preventDefault();
            let evId = e.dataTransfer.getData("text/plain");
            moveEventToDate(evId, dateStr);
          };

          cell.onclick = (e) => {
            if (e.target.tagName !== 'DIV' && e.target.tagName !== 'SPAN') return;
            openEventModalForDate(dateStr);
          };

          let todayStr = new Date().toISOString().split('T')[0];
          let isToday = dateStr === todayStr;

          let eventsHtml = dayEvents.map(ev => {
            let isAuto = ev.type === 'action' || ev.type === 'maintenance';
            let bgClass = isAuto ? 'bg-amber-100 text-amber-900 border-amber-300' : (ev.scope === 'GERAL' ? 'bg-purple-100 text-purple-900 border-purple-300' : 'bg-sky-100 text-sky-900 border-sky-300');
            return `
              <div draggable="true" 
                   ondragstart="event.dataTransfer.setData('text/plain', '${ev.id}')"
                   onclick="event.stopPropagation(); openEventDetail('${ev.id}')" 
                   class="event-card px-1.5 py-0.5 rounded border text-[10px] font-semibold truncate cursor-pointer mb-0.5 ${bgClass} relative group" 
                   title="${ev.title}">
                • ${ev.time ? ev.time + ' ' : ''}${ev.title}
                <div class="resize-handle opacity-0 group-hover:opacity-100 bg-black/20" onmousedown="initResize(event, '${ev.id}')" title="Redimensionar horário"></div>
              </div>`;
          }).join("");

          cell.innerHTML = `
            <div class="font-bold text-stone-700 mb-1 flex justify-between items-center pointer-events-none">
              <span class="${isToday ? 'bg-cb-bordo text-cb-gold px-1.5 py-0.5 rounded-full' : ''}">${d}</span>
            </div>
            <div class="flex-1 overflow-y-auto space-y-0.5 max-h-[70px]">${eventsHtml}</div>`;
          table.appendChild(cell);
        }
        gridContainer.appendChild(table);

      } else if (currentCalendarView === 'week') {
        let currDate = new Date(currentCalendarDate);
        let firstDayOfWeek = new Date(currDate.setDate(currDate.getDate() - currDate.getDay()));
        let lastDayOfWeek = new Date(firstDayOfWeek);
        lastDayOfWeek.setDate(lastDayOfWeek.getDate() + 6);

        titleEl.innerText = `Semana: ${firstDayOfWeek.toLocaleDateString('pt-BR')} a ${lastDayOfWeek.toLocaleDateString('pt-BR')}`;

        let table = document.createElement("div");
        table.className = "divide-y text-xs";

        for (let i = 0; i < 7; i++) {
          let loopDate = new Date(firstDayOfWeek);
          loopDate.setDate(loopDate.getDate() + i);
          let dateStr = loopDate.toISOString().split('T')[0];
          let dayEvents = filteredEvents.filter(e => e.date === dateStr);

          let row = document.createElement("div");
          row.className = "p-3 flex flex-col sm:flex-row gap-2 justify-between items-start sm:items-center bg-white hover:bg-stone-50 transition cursor-pointer";
          row.ondragover = (e) => e.preventDefault();
          row.ondrop = (e) => {
            e.preventDefault();
            let evId = e.dataTransfer.getData("text/plain");
            moveEventToDate(evId, dateStr);
          };
          row.onclick = () => openEventModalForDate(dateStr);

          let eventsHtml = dayEvents.map(ev => `
            <span draggable="true" 
                  ondragstart="event.dataTransfer.setData('text/plain', '${ev.id}')"
                  onclick="event.stopPropagation(); openEventDetail('${ev.id}')" 
                  class="event-card px-2.5 py-1 bg-amber-100 text-amber-900 border rounded font-semibold text-[11px] cursor-pointer hover:bg-amber-200">
              ${ev.time ? ev.time + ' - ' : ''}${ev.title}
            </span>`).join(" ");

          row.innerHTML = `
            <div class="font-bold text-cb-bordo w-36 pointer-events-none">${loopDate.toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: '2-digit' })}</div>
            <div class="flex-1 flex gap-2 flex-wrap items-center">${eventsHtml || '<span class="text-stone-400 italic">Nenhum evento neste dia</span>'}</div>`;
          table.appendChild(row);
        }
        gridContainer.appendChild(table);

      } else if (currentCalendarView === 'day') {
        let dateStr = currentCalendarDate.toISOString().split('T')[0];
        titleEl.innerText = `Dia: ${currentCalendarDate.toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' })}`;

        let dayEvents = filteredEvents.filter(e => e.date === dateStr);
        let listDiv = document.createElement("div");
        listDiv.className = "p-4 space-y-3 text-xs";

        if (dayEvents.length === 0) {
          listDiv.innerHTML = `<div class="text-center text-stone-400 py-6">Nenhum compromisso ou evento agendado para hoje. <button onclick="openEventModalForDate('${dateStr}')" class="text-cb-bordo font-bold underline block mx-auto mt-1">+ Criar Evento</button></div>`;
        } else {
          dayEvents.forEach(ev => {
            let item = document.createElement("div");
            item.className = "p-3 bg-stone-50 border rounded-xl flex justify-between items-center";
            item.innerHTML = `
              <div class="space-y-1">
                <span class="font-bold text-sm text-cb-bordo block">${ev.time ? '⏰ ' + ev.time + ' — ' : ''}${ev.title}</span>
                <span class="text-stone-600">${ev.desc}</span>
                <span class="text-[10px] text-stone-400 block">Loja: ${ev.store}</span>
              </div>
              <button onclick="openEventDetail('${ev.id}')" class="px-3 py-1.5 bg-cb-bordo text-white font-bold rounded">Detalhes / Editar</button>`;
            listDiv.appendChild(item);
          });
        }
        gridContainer.appendChild(listDiv);
      }
    }

    function moveEventToDate(eventId, newDate) {
      let ev = calendarEvents.find(e => e.id === eventId);
      if (!ev) return;
      if (ev.scope === 'GERAL' && currentUser.role !== 'admin') {
        return alert("Apenas administradores podem alterar eventos em comum.");
      }
      if (currentUser.role === 'gerente' && ev.store !== currentUser.units?.[0]) {
        return alert("Você só pode mover eventos da sua própria unidade.");
      }

      ev.date = newDate;
      ev.displayDate = newDate.split('-').reverse().join('/');
      localStorage.setItem("CB_LOCAL_CALENDAR_EVENTS", JSON.stringify(calendarEvents));
      syncConfigToCloud();
      renderAgendaCalendar();
    }

    function initResize(e, eventId) {
      e.stopPropagation();
      e.preventDefault();
      let ev = calendarEvents.find(e => e.id === eventId);
      if (!ev) return;

      let startY = e.clientY;
      function onMouseMove(moveEvent) {
        let diff = moveEvent.clientY - startY;
        if (Math.abs(diff) > 25) {
          let [h, m] = (ev.timeEnd || '10:00').split(':').map(Number);
          m += diff > 0 ? 30 : -30;
          if (m >= 60) { h += 1; m = 0; }
          if (m < 0) { h -= 1; m = 30; }
          ev.timeEnd = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
          startY = moveEvent.clientY;
          localStorage.setItem("CB_LOCAL_CALENDAR_EVENTS", JSON.stringify(calendarEvents));
          syncConfigToCloud();
          renderAgendaCalendar();
        }
      }

      function onMouseUp() {
        window.removeEventListener('mousemove', onMouseMove);
        window.removeEventListener('mouseup', onMouseUp);
      }

      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseup', onMouseUp);
    }

    function processarAgendaIA() {
      const texto = document.getElementById("ia-input").value;
      if (!texto) return alert("Digite um comando para a IA.");

      let novoEvento = { title: texto.split(/dia|às/i)[0].trim(), data: "", hora: "09:00", loja: "" };

      const dataMatch = texto.match(/\d{2}\/\d{2}(\/\d{4})?/);
      if (dataMatch) {
          let partes = dataMatch[0].split('/');
          let ano = partes[2] || new Date().getFullYear();
          novoEvento.data = `${ano}-${partes[1].padStart(2, '0')}-${partes[0].padStart(2, '0')}`;
      }

      presetUnits.forEach(u => {
          if (texto.toLowerCase().includes(u.toLowerCase().split(' ').slice(1).join(' '))) novoEvento.loja = u;
      });

      document.getElementById("event-title").value = novoEvento.title;
      document.getElementById("event-date").value = novoEvento.data || new Date().toISOString().split('T')[0];
      document.getElementById("event-time-start").value = novoEvento.hora;

      if (novoEvento.loja) {
          document.getElementById("event-scope").value = "INDIVIDUAL";
          document.getElementById("event-store").value = novoEvento.loja;
          toggleEventStoreSelect();
      }

      document.getElementById("event-modal").classList.remove("hidden");
      document.getElementById("ia-input").value = "";
    }

