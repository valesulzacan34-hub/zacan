    async function confirmMaintenanceResolution() {
      const actionId = document.getElementById("res-action-id").value;
      const empresa = document.getElementById("res-empresa").value.trim();
      const contato = document.getElementById("res-contato").value.trim();
      const equipamento = document.getElementById("res-equipamento").value.trim();
      const vMao = parseFloat(document.getElementById("res-v-mao").value) || 0;
      const vPecas = parseFloat(document.getElementById("res-v-pecas").value) || 0;
      const gMao = parseInt(document.getElementById("res-g-mao").value) || 0;
      const gPecas = parseInt(document.getElementById("res-g-pecas").value) || 0;
      const desc = document.getElementById("res-desc").value.trim();
      const nfInput = document.getElementById("res-nf-file");

      if (!empresa || !equipamento) return alert("Preencha ao menos o nome da empresa/prestador e o equipamento.");

      let existingTech = techniciansList.find(t => t.name.toLowerCase() === empresa.toLowerCase());
      if (!existingTech) {
        if (confirm(`A empresa "${empresa}" não está na sua base de Manutenção. Deseja salvá-la automaticamente como novo prestador?`)) {
          techniciansList.push({
            name: empresa,
            service: equipamento,
            region: 'Geral',
            phone: contato || '(00) 00000-0000'
          });
          localStorage.setItem("CB_LOCAL_TECHNICIANS", JSON.stringify(techniciansList));
          syncConfigToCloud();
        }
      }

      let nfUrl = '';
      if (nfInput && nfInput.files && nfInput.files[0]) {
        try {
          nfUrl = await compressImageFile(nfInput.files[0], 1024, 0.7);
        } catch(e) {
          console.error("Erro ao compactar NF:", e);
        }
      }

      const now = new Date();
      const dataConclusao = now.toLocaleDateString('pt-BR');

      const maxDias = Math.max(gMao, gPecas);
      const garantiaFimDate = new Date(now.getTime() + (maxDias * 24 * 60 * 60 * 1000));
      const dataGarantiaFim = garantiaFimDate.toLocaleDateString('pt-BR');

      const warrantyObj = {
        id: "gar_" + Date.now(),
        actionId: actionId,
        empresa,
        contato,
        equipamento,
        vMao,
        vPecas,
        nfUrl,
        gMao,
        gPecas,
        desc,
        dataConclusao,
        dataGarantiaFim
      };

      warrantyRecords.push(warrantyObj);
      localStorage.setItem("CB_LOCAL_WARRANTY_RECORDS", JSON.stringify(warrantyRecords));

      actionCustomStatus[actionId] = 'Concluído';
      localStorage.setItem("CB_LOCAL_CUSTOM_STATUS", JSON.stringify(actionCustomStatus));
      syncConfigToCloud();

      closeMaintenanceResolutionModal();
      renderCentralizedActions();
      updateNotificationBadgeCount();
      alert("Manutenção concluída e garantia registrada com sucesso!");
    }

