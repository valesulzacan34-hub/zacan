    function setupCloudListeners() {
      if (!isFirebaseReady) {
        updateSyncUI("🟡 Modo Local", "Sem conexão");
        return;
      }

      updateSyncUI("🟢 Conectando...", "Sincronizando");

      db.collection("app_config").doc("main").onSnapshot(doc => {
        if (doc.exists) {
          const data = doc.data();
          if (data.checklists) { allChecklists = data.checklists; localStorage.setItem("CB_LOCAL_CHECKLISTS", JSON.stringify(allChecklists)); }
          if (data.units) { presetUnits = data.units; localStorage.setItem("CB_LOCAL_UNITS", JSON.stringify(presetUnits)); }
          if (data.users) { users = data.users; localStorage.setItem("CB_LOCAL_USERS", JSON.stringify(users)); }
          if (data.statuses) { actionStatuses = data.statuses; localStorage.setItem("CB_LOCAL_STATUSES", JSON.stringify(actionStatuses)); }
          if (data.priorities) { actionPriorities = data.priorities; localStorage.setItem("CB_LOCAL_PRIORITIES", JSON.stringify(actionPriorities)); }
          if (data.technicians) { techniciansList = data.technicians; localStorage.setItem("CB_LOCAL_TECHNICIANS", JSON.stringify(techniciansList)); }
          if (data.calendarEvents) { calendarEvents = data.calendarEvents; localStorage.setItem("CB_LOCAL_CALENDAR_EVENTS", JSON.stringify(calendarEvents)); }
          if (data.customStatus) { actionCustomStatus = data.customStatus; localStorage.setItem("CB_LOCAL_CUSTOM_STATUS", JSON.stringify(actionCustomStatus)); }
          if (data.customPriority) { actionCustomPriority = data.customPriority; localStorage.setItem("CB_LOCAL_CUSTOM_PRIORITY", JSON.stringify(actionCustomPriority)); }
          if (data.manualActions) { manualActionsList = data.manualActions; localStorage.setItem("CB_LOCAL_MANUAL_ACTIONS", JSON.stringify(manualActionsList)); }
          if (data.trashActions) { trashActionsList = data.trashActions; localStorage.setItem("CB_LOCAL_TRASH_ACTIONS", JSON.stringify(trashActionsList)); }
          if (data.reportsTrash) { reportsTrashList = data.reportsTrash; localStorage.setItem("CB_LOCAL_REPORTS_TRASH", JSON.stringify(reportsTrashList)); }
          if (data.warrantyRecords) { warrantyRecords = data.warrantyRecords; localStorage.setItem("CB_LOCAL_WARRANTY_RECORDS", JSON.stringify(warrantyRecords)); }

          renderPresetUnits();
          renderHomeChecklistSelect();
          renderAgendaCalendar();
          updateSyncUI("🟢 Sincronizado na Nuvem", new Date().toLocaleTimeString('pt-BR'));
        } else {
          syncConfigToCloud();
        }
      });

      db.collection("reports").orderBy("createdAt", "desc").onSnapshot(snapshot => {
        let tempReports = [];
        snapshot.forEach(doc => {
          let rep = { id: doc.id, ...doc.data() };
          if (!reportsTrashList.some(t => t.id === rep.id)) {
            tempReports.push(rep);
          }
        });
        savedReports = tempReports;
        try { localStorage.setItem("CB_LOCAL_REPORTS", JSON.stringify(savedReports)); } catch(e){}
        updateHistoryBadge();
        renderHistoryList();
        renderCentralizedActions();
        renderAgendaCalendar();
        listenToAllChats();
      });
    }

    function syncConfigToCloud() {
      if (!isFirebaseReady) return;
      db.collection("app_config").doc("main").set({
        checklists: allChecklists,
        units: presetUnits,
        users: users,
        statuses: actionStatuses,
        priorities: actionPriorities,
        technicians: techniciansList,
        calendarEvents: calendarEvents,
        customStatus: actionCustomStatus,
        customPriority: actionCustomPriority,
        manualActions: manualActionsList,
        trashActions: trashActionsList,
        reportsTrash: reportsTrashList,
        warrantyRecords: warrantyRecords,
        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
      }).catch(err => console.error(err));
    }

