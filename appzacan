    function restoreActionFromTrash(idx) {
      let item = trashActionsList.splice(idx, 1)[0];
      if (!item) return;

      if (item.isManual || item.id) {
        if (!manualActionsList.some(a => a.id === item.id)) {
          manualActionsList.push(item);
          localStorage.setItem("CB_LOCAL_MANUAL_ACTIONS", JSON.stringify(manualActionsList));
        }
      } else if (item.fullReportId) {
        let rep = savedReports.find(r => r.id === item.fullReportId);
        if (rep) {
          if (item.type === 'nc') rep.nonConformities.push(item);
          if (item.type === 'om') rep.maintenanceOrders.push(item);
          try { localStorage.setItem("CB_LOCAL_REPORTS", JSON.stringify(savedReports)); } catch(e){}
        }
      }

      localStorage.setItem("CB_LOCAL_TRASH_ACTIONS", JSON.stringify(trashActionsList));
      syncConfigToCloud();
      renderCentralizedActions();
      renderTrashActionsList();
      alert("Plano de ação restaurado com sucesso!");
    }

