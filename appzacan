    function saveCalendarEvent() {
      let id = document.getElementById("event-edit-id").value || "ev_" + Date.now();
      let title = document.getElementById("event-title").value.trim();
      let date = document.getElementById("event-date").value;
      let scope = document.getElementById("event-scope").value;
      let store = scope === 'INDIVIDUAL' ? (currentUser.role === 'gerente' ? currentUser.units[0] : document.getElementById("event-store").value) : 'GERAL';
      let time = document.getElementById("event-time-start").value;
      let timeEnd = document.getElementById("event-time-end").value;
      let recurrence = document.getElementById("event-recurrence").value;
      let desc = document.getElementById("event-desc").value.trim();

      if (!title || !date) return alert("Preencha o título e a data do evento.");
      if (scope === 'GERAL' && currentUser.role !== 'admin') return alert("Apenas administradores podem criar ou editar eventos em comum para toda a rede.");

      let existingIdx = calendarEvents.findIndex(e => e.id === id);
      let evObj = { id, title, date, displayDate: date.split('-').reverse().join('/'), store, scope, time, timeEnd, recurrence, desc, type: 'manual' };

      if (existingIdx >= 0) {
        if (calendarEvents[existingIdx].scope === 'GERAL' && currentUser.role !== 'admin') {
          return alert("Apenas administradores podem modificar eventos em comum.");
        }
        calendarEvents[existingIdx] = evObj;
      } else {
        calendarEvents.push(evObj);
      }

      localStorage.setItem("CB_LOCAL_CALENDAR_EVENTS", JSON.stringify(calendarEvents));
      syncConfigToCloud();
      toggleEventModal();
      renderAgendaCalendar();
      alert("Evento salvo com sucesso na agenda!");
    }

