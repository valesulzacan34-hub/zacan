    function renderPresetUnits() {
      const select = document.getElementById("unit-selector");
      const filterStore = document.getElementById("filter-store");
      const filterActionStore = document.getElementById("filter-action-store");
      const filterAgendaStore = document.getElementById("filter-agenda-store");
      const eventStoreSelect = document.getElementById("event-store");
      const manualActUnit = document.getElementById("manual-action-unit");
      const listContainer = document.getElementById("admin-units-list");
      const allowedUnits = getAllowedUnits();

      if (select) {
        const currentVal = select.value;
        select.innerHTML = "";
        allowedUnits.forEach(u => {
          const opt = document.createElement("option"); opt.value = u; opt.innerText = u; select.appendChild(opt);
        });
        if (currentVal && allowedUnits.includes(currentVal)) select.value = currentVal;
      }

      if (manualActUnit) {
        manualActUnit.innerHTML = "";
        allowedUnits.forEach(u => {
          const opt = document.createElement("option"); opt.value = u; opt.innerText = u; manualActUnit.appendChild(opt);
        });
      }

      if (filterStore) {
        const currentFilter = filterStore.value;
        filterStore.innerHTML = `<option value="">Todas as Lojas Permitidas</option>`;
        allowedUnits.forEach(u => {
          const opt = document.createElement("option"); opt.value = u; opt.innerText = u; filterStore.appendChild(opt);
        });
        filterStore.value = currentFilter;
      }

      if (filterActionStore) {
        const currentFilterAct = filterActionStore.value;
        filterActionStore.innerHTML = `<option value="">Todas as Lojas</option>`;
        presetUnits.forEach(u => {
          const opt = document.createElement("option"); opt.value = u; opt.innerText = u; filterActionStore.appendChild(opt);
        });
        filterActionStore.value = currentFilterAct;
      }

      if (filterAgendaStore) {
        const curAgenda = filterAgendaStore.value;
        if (currentUser && currentUser.role === 'gerente') {
          filterAgendaStore.innerHTML = "";
          let managerUnit = currentUser.units && currentUser.units.length > 0 ? currentUser.units[0] : presetUnits[0];
          let opt = document.createElement("option"); opt.value = managerUnit; opt.innerText = managerUnit; filterAgendaStore.appendChild(opt);
          filterAgendaStore.value = managerUnit;
          filterAgendaStore.disabled = true;
        } else {
          filterAgendaStore.innerHTML = `<option value="GERAL">⭐ Eventos em Comum (Todas as Lojas)</option>`;
          allowedUnits.forEach(u => {
            const opt = document.createElement("option"); opt.value = u; opt.innerText = u; filterAgendaStore.appendChild(opt);
          });
          if (curAgenda) filterAgendaStore.value = curAgenda;
        }
      }

      if (eventStoreSelect) {
        eventStoreSelect.innerHTML = "";
        let unitsToDisplay = currentUser && currentUser.role === 'gerente' && currentUser.units ? currentUser.units : presetUnits;
        unitsToDisplay.forEach(u => {
          const opt = document.createElement("option"); opt.value = u; opt.innerText = u; eventStoreSelect.appendChild(opt);
        });
      }

      if (listContainer) {
        listContainer.innerHTML = "";
        presetUnits.forEach((u, idx) => {
          const item = document.createElement("div");
          item.className = "flex justify-between items-center p-2 bg-stone-50 rounded border text-xs";
          item.innerHTML = `<span class="font-bold">${u}</span><div class="flex gap-2"><button onclick="adminEditUnit(${idx})" class="text-stone-600 font-bold">Editar</button><button onclick="adminDeleteUnit(${idx})" class="text-rose-600 font-bold">Excluir</button></div>`;
          listContainer.appendChild(item);
        });
      }
    }

