    function deleteActionPlanDirect(chatId, fullReportId, type, index, isManual) {
      let deletedData = null;
      if (isManual) {
        let idx = manualActionsList.findIndex(a => a.id === chatId);
        if (idx >= 0) {
          deletedData = manualActionsList[idx];
          manualActionsList.splice(idx, 1);
          localStorage.setItem("CB_LOCAL_MANUAL_ACTIONS", JSON.stringify(manualActionsList));
        }
      } else {
        let rep = savedReports.find(r => r.id === fullReportId);
        if (rep) {
          if (type === 'nc' && rep.nonConformities) {
            deletedData = { ...rep.nonConformities[index], fullReportId, type, index };
            rep.nonConformities.splice(index, 1);
          } else if (type === 'om' && rep.maintenanceOrders) {
            deletedData = { ...rep.maintenanceOrders[index], fullReportId, type, index };
            rep.maintenanceOrders.splice(index, 1);
          }
          try { localStorage.setItem("CB_LOCAL_REPORTS", JSON.stringify(savedReports)); } catch(e){}
          if (isFirebaseReady) {
            db.collection("reports").doc(fullReportId).update({
              nonConformities: rep.nonConformities || [],
              maintenanceOrders: rep.maintenanceOrders || []
            });
          }
        }
      }
      if (deletedData) {
        trashActionsList.push({ ...deletedData, deletedAt: new Date().toLocaleDateString('pt-BR') });
        localStorage.setItem("CB_LOCAL_TRASH_ACTIONS", JSON.stringify(trashActionsList));
      }
    }

