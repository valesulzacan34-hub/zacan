    function updateHistoryBadge() {
      const count = savedReports.length;
      const b1 = document.getElementById("history-badge-count");
      const b2 = document.getElementById("history-badge-count-main");
      if (b1) b1.innerText = count;
      if (b2) b2.innerText = count;
      updateNotificationBadgeCount();
      updateDraftsBadge();
      const trashCountEl = document.getElementById("reports-trash-count");
      if (trashCountEl) trashCountEl.innerText = reportsTrashList.length;
    }

    function renderHistoryList() {
      const container = document.getElementById("history-list-container");
      if (!container) return;
      container.innerHTML = ""; 
      updateHistoryBadge();

      const storeFilter = document.getElementById("filter-store")?.value || "";
      const startFilter = document.getElementById("filter-date-start")?.value || "";
      const endFilter = document.getElementById("filter-date-end")?.value || "";
      const allowedUnits = getAllowedUnits();

      let filtered = savedReports.filter(rep => {
        if (!rep || !allowedUnits.includes(rep.unit)) return false;
        let matchStore = !storeFilter || rep.unit === storeFilter;
        let matchDate = true;
        if (rep.date) {
          let datePart = rep.date.split(',')[0].trim();
          let parts = datePart.split('/');
          if (parts.length === 3) {
            let repIso = `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
            if (startFilter && repIso < startFilter) matchDate = false;
            if (endFilter && repIso > endFilter) matchDate = false;
          }
        }
        return matchStore && matchDate;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div class="p-8 text-center bg-white rounded-xl border text-stone-400 text-xs">Nenhum relatório encontrado para o período.</div>`;
        return;
      }

      filtered.forEach((rep, idx) => {
        const itemCard = document.createElement("div");
        itemCard.className = "bg-white rounded-xl border border-stone-200 shadow-sm overflow-hidden text-xs";

        let ncListHtml = rep.nonConformities?.map(nc => `<div class="p-2 bg-rose-50 border border-rose-200 rounded text-xs mb-1"><strong>❌ ${nc.title}</strong><br>Ação: ${nc.action} (Prazo: ${nc.date})</div>`).join("") || "";
        let omListHtml = rep.maintenanceOrders?.map(om => `<div class="p-2 bg-amber-50 border border-amber-300 rounded text-xs mb-1"><strong>🔧 ${om.equipment}</strong><br>Defeito: ${om.action} (Prazo: ${om.date})</div>`).join("") || "";

        itemCard.innerHTML = `
          <div onclick="toggleHistoryDetails(${idx})" class="p-3.5 bg-stone-50 hover:bg-stone-100 flex justify-between items-center cursor-pointer transition">
            <div class="flex items-center gap-3">
              <span class="font-black text-cb-bordo text-sm">${rep.unit}</span>
              <span class="text-stone-500">${rep.date}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="px-2 py-0.5 rounded font-bold text-white ${rep.score >= 90 ? 'bg-emerald-600' : rep.score >= 75 ? 'bg-amber-600' : 'bg-rose-600'}">${rep.score}%</span>
              <span id="chevron-${idx}" class="text-stone-400 font-bold">▼</span>
            </div>
          </div>
          <div id="history-details-${idx}" class="hidden p-4 border-t space-y-3 bg-white">
            <div><strong>Supervisor:</strong> ${rep.supervisor}</div>
            <div><strong>Não Conformidades:</strong><br>${ncListHtml || 'Nenhuma'}</div>
            ${omListHtml ? `<div><strong>Ordens de Manutenção:</strong><br>${omListHtml}</div>` : ''}
            <div class="pt-2 border-t flex justify-end gap-2">
              <button onclick="reopenPDFFromHistoryByIndex('${rep.id}')" class="px-3 py-1.5 bg-cb-bordo text-white font-bold rounded-lg">Visualizar / Imprimir PDF</button>
              <button onclick="deleteReportFromHistory('${rep.id}')" class="px-2.5 py-1.5 text-rose-600 font-bold">Mover para Lixeira</button>
            </div>
          </div>`;
        container.appendChild(itemCard);
      });
    }

    function toggleHistoryDetails(idx) {
      const details = document.getElementById(`history-details-${idx}`);
      const chevron = document.getElementById(`chevron-${idx}`);
      details.classList.toggle("hidden");
      chevron.innerText = details.classList.contains("hidden") ? "▼" : "▲";
    }

    function deleteReportFromHistory(docId) {
      if (confirm("Deseja mover este relatório para a lixeira?")) {
        const itemToDelete = savedReports.find(r => r.id === docId);
        savedReports = savedReports.filter(r => r.id !== docId);
        try { localStorage.setItem("CB_LOCAL_REPORTS", JSON.stringify(savedReports)); } catch(e){}
        
        if (itemToDelete) {
          reportsTrashList.push({ ...itemToDelete, deletedAt: new Date().toLocaleDateString('pt-BR') });
          localStorage.setItem("CB_LOCAL_REPORTS_TRASH", JSON.stringify(reportsTrashList));
        }

        if (isFirebaseReady && docId) {
          db.collection("reports").doc(docId).delete().catch(err => console.error("Erro ao deletar do Firestore:", err));
        }

        syncConfigToCloud();
        renderHistoryList();
        updateNotificationBadgeCount();
        triggerUndoToast("Relatório", "report", itemToDelete);
      }
    }

    function toggleReportsTrashModal() {
      const modal = document.getElementById("reports-trash-modal");
      modal.classList.toggle("hidden");
      if (!modal.classList.contains("hidden")) {
        renderReportsTrashList();
      }
    }

    function renderReportsTrashList() {
      const container = document.getElementById("reports-trash-list");
      if (!container) return;
      container.innerHTML = "";

      if (reportsTrashList.length === 0) {
        container.innerHTML = `<div class="p-6 text-center text-stone-400 text-xs">A lixeira de relatórios está vazia.</div>`;
        return;
      }

      reportsTrashList.forEach((rep, idx) => {
        const div = document.createElement("div");
        div.className = "p-3 bg-white border rounded-xl flex justify-between items-center shadow-sm text-xs";
        div.innerHTML = `
          <div>
            <span class="font-bold text-cb-bordo block">${rep.unit} — ${rep.date}</span>
            <span class="text-stone-500">Supervisor: ${rep.supervisor} | Nota: ${rep.score}%</span>
          </div>
          <div class="flex gap-2">
            <button onclick="restoreReportFromTrash(${idx})" class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded shadow-sm">Restaurar</button>
            ${currentUser?.role === 'admin' ? `<button onclick="permanentDeleteReport(${idx})" class="px-2 py-1.5 bg-rose-600 text-white font-bold rounded shadow-sm">Excluir Definitivo</button>` : ''}
          </div>
        `;
        container.appendChild(div);
      });
    }

    function restoreReportFromTrash(idx) {
      let rep = reportsTrashList.splice(idx, 1)[0];
      if (rep) {
        if (!savedReports.some(r => r.id === rep.id)) {
          savedReports.unshift(rep);
          try { localStorage.setItem("CB_LOCAL_REPORTS", JSON.stringify(savedReports)); } catch(e){}
          if (isFirebaseReady) db.collection("reports").doc(rep.id).set(rep);
        }
        localStorage.setItem("CB_LOCAL_REPORTS_TRASH", JSON.stringify(reportsTrashList));
        syncConfigToCloud();
        renderHistoryList();
        renderReportsTrashList();
        alert("Relatório restaurado com sucesso!");
      }
    }

    function permanentDeleteReport(idx) {
      if (confirm("Excluir definitivamente este relatório? Esta ação não poderá ser desfeita.")) {
        const rep = reportsTrashList.splice(idx, 1)[0];
        if (rep && isFirebaseReady) {
          db.collection("reports").doc(rep.id).delete().catch(err => console.error(err));
        }
        localStorage.setItem("CB_LOCAL_REPORTS_TRASH", JSON.stringify(reportsTrashList));
        syncConfigToCloud();
        renderReportsTrashList();
        alert("Relatório excluído definitivamente.");
      }
    }

    function reopenPDFFromHistoryByIndex(docId) {
      const rep = savedReports.find(r => r.id === docId);
      if (rep) openPrintWindow(rep.htmlContent);
    }

