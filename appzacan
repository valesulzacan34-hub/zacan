<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Sistema Integrado - Casa Bauducco</title>

  <link rel="icon" type="image/png" href="./logo.png">

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-firestore-compat.js"></script>
  <style>
    :root {
      --cb-bordo: #4A0E17;
      --cb-bordo-dark: #36070E;
      --cb-gold: #D4AF37;
      --cb-cream: #FAF7F2;
    }
    .bg-cb-bordo { background-color: var(--cb-bordo); }
    .bg-cb-bordo-dark { background-color: var(--cb-bordo-dark); }
    .text-cb-bordo { color: var(--cb-bordo); }
    .text-cb-gold { color: var(--cb-gold); }
    .border-cb-gold { border-color: var(--cb-gold); }
    .bg-cb-cream { background-color: var(--cb-cream); }
    #sidebar { transition: transform 0.3s ease-in-out; }
    .event-card { cursor: grab; }
    .event-card:active { cursor: grabbing; }
    .resize-handle { height: 4px; width: 100%; cursor: ns-resize; position: absolute; bottom: 0; left: 0; }
    @media (min-width: 768px) {
      .app-main, .responsive-container { max-width: 100% !important; width: 100% !important; margin: 0 auto; padding-left: 2rem; padding-right: 2rem; }
    }
    @media (max-width: 767px) {
      .app-main, .responsive-container { max-width: 100% !important; padding-left: 0.75rem; padding-right: 0.75rem; }
    }
  </style>
</head>
<body class="bg-cb-cream text-stone-800 antialiased pb-36 font-sans">

  <!-- Toast de Desfazer Exclusão -->
  <div id="undo-toast" class="fixed bottom-16 right-4 bg-stone-900 text-white px-4 py-3 rounded-xl shadow-2xl z-[100] hidden flex items-center gap-3 text-xs border border-cb-gold/40">
    <span id="undo-text">Item excluído.</span>
    <button onclick="executeUndo()" class="bg-cb-gold text-cb-bordo font-bold px-2.5 py-1 rounded hover:bg-yellow-500 transition uppercase text-[10px]">Desfazer</button>
  </div>

  <div id="cloud-sync-status" class="bg-stone-900 text-[10px] text-stone-300 px-3 py-1 flex justify-between items-center z-50">
    <span id="sync-indicator">🟢 Sincronizado na Nuvem</span>
    <span id="sync-time" class="text-stone-400 font-mono">Conectando...</span>
  </div>

  <div id="image-viewer-modal" class="fixed inset-0 z-[100] bg-black/90 hidden flex items-center justify-center p-4" onclick="this.classList.add('hidden')">
    <img id="viewer-img" class="max-w-full max-h-full object-contain rounded-lg" alt="Visualização">
    <span class="absolute top-4 right-4 text-white text-3xl font-bold cursor-pointer">✕</span>
  </div>

  <!-- Tela de Login -->
  <div id="login-screen" class="fixed inset-0 bg-cb-bordo-dark z-50 flex items-center justify-center p-4">
    <div class="bg-white w-full max-w-sm rounded-2xl p-6 space-y-4 shadow-2xl border border-cb-gold/30">
      <div class="flex flex-col items-center justify-center">
        <img id="login-logo-img" src="./logo.png" alt="Casa Bauducco" class="h-24 w-auto object-contain">
        <p class="text-xs text-stone-500 font-medium mt-1">Acesso à Supervisão Operacional</p>
      </div>

      <div class="space-y-3 text-sm">
        <div>
          <label class="block text-xs font-bold text-cb-bordo uppercase tracking-wider mb-1">Usuário</label>
          <input type="text" id="login-user" placeholder="Digite seu usuário" class="w-full border rounded-lg p-2.5 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cb-bordo">
        </div>
        <div>
          <label class="block text-xs font-bold text-cb-bordo uppercase tracking-wider mb-1">Senha</label>
          <input type="password" id="login-pass" placeholder="Digite sua senha" class="w-full border rounded-lg p-2.5 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-cb-bordo" onkeydown="if(event.key === 'Enter') handleLogin()">
        </div>
      </div>

      <p id="login-error" class="text-xs text-rose-600 font-semibold text-center hidden">Usuário ou senha incorretos!</p>

      <button onclick="handleLogin()" class="w-full py-3 bg-cb-bordo hover:bg-cb-bordo-dark text-white font-bold text-xs rounded-lg transition uppercase tracking-widest border border-cb-gold/40 shadow-md">
        Entrar
      </button>
    </div>
  </div>

  <!-- Tela de Seleção de Módulos -->
  <div id="modules-screen" class="fixed inset-0 bg-cb-bordo-dark z-40 hidden flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white w-full max-w-sm rounded-2xl p-6 space-y-5 shadow-2xl border border-cb-gold/30 text-center">
      <div>
        <img id="modules-logo-img" src="./logo.png" alt="Casa Bauducco" class="h-14 w-auto object-contain mx-auto mb-1">
        <h2 class="text-xs font-bold text-cb-bordo uppercase tracking-wider">Painel Principal</h2>
        <p class="text-[11px] text-stone-500">Selecione o módulo que deseja acessar</p>
      </div>

      <div id="modules-grid" class="modules-grid grid gap-3 text-left"></div>

      <button onclick="handleLogout()" class="text-xs text-rose-600 font-bold hover:underline pt-1 block mx-auto">
        Encerrar Sessão (Sair)
      </button>
    </div>
  </div>

  <div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-black/50 z-40 hidden transition-opacity"></div>
  <div id="sidebar" class="fixed top-0 left-0 bottom-0 w-64 bg-cb-bordo-dark text-white z-50 transform -translate-x-full shadow-2xl flex flex-col border-r border-cb-gold/30">
    <div class="p-4 border-b border-cb-gold/20 flex justify-between items-center bg-cb-bordo">
      <div>
        <h3 class="font-bold text-xs uppercase text-cb-gold">Menu Principal</h3>
        <p id="sidebar-user-name" class="text-[11px] text-stone-300">Operador</p>
      </div>
      <button onclick="toggleSidebar()" class="text-stone-300 hover:text-white text-lg font-bold p-1">✕</button>
    </div>

    <div class="p-3 space-y-1.5 flex-1 text-xs font-semibold overflow-y-auto">
      <button onclick="openModulesScreen(); toggleSidebar();" class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-cb-bordo transition">
        🏠 Tela Inicial (Módulos)
      </button>
      <button onclick="selectModule('checklists'); toggleSidebar();" class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-cb-bordo transition flex items-center gap-1.5">
        <span>📋 Checklists</span>
      </button>
      <button onclick="selectModule('actions'); toggleSidebar();" class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-cb-bordo transition flex items-center gap-1.5">
        <span>📋 Planos de Ação</span>
      </button>
      <button onclick="selectModule('agenda'); toggleSidebar();" class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-cb-bordo transition flex items-center gap-1.5">
        <span>📅 Agenda & Calendário</span>
      </button>
      <button onclick="selectModule('technicians'); toggleSidebar();" class="w-full text-left px-3 py-2.5 rounded-lg hover:bg-cb-bordo transition flex items-center gap-1.5">
        <span>🔧 Manutenção</span>
      </button>
      <button id="sidebar-btn-users" onclick="toggleUsersModal(); toggleSidebar();" class="hidden w-full text-left px-3 py-2.5 rounded-lg hover:bg-cb-bordo transition">
        👥 Gerenciar Unidades & Usuários
      </button>
    </div>

    <div class="p-3 border-t border-cb-gold/20">
      <button onclick="handleLogout()" class="w-full py-2 bg-rose-900/40 hover:bg-rose-900 text-rose-200 text-xs font-bold rounded-lg transition uppercase">
        Sair
      </button>
    </div>
  </div>

  <header class="bg-cb-bordo text-white sticky top-0 z-30 shadow-lg border-b-2 border-cb-gold">
    <div class="w-full px-6 py-2.5 flex justify-between items-center">
      <div class="flex items-center gap-2.5">
        <button onclick="toggleSidebar()" class="p-1.5 bg-cb-bordo-dark border border-cb-gold/40 rounded-lg text-stone-200 hover:text-white transition text-sm font-bold">
          ☰
        </button>
        <div class="bg-white p-1 rounded-lg shadow-sm flex items-center justify-center">
          <img id="header-logo-img" src="./logo.png" alt="Casa Bauducco" class="h-8 w-auto object-contain">
        </div>
        <div>
          <h1 class="text-xs font-bold tracking-wider uppercase text-cb-gold" id="header-app-title">Casa Bauducco</h1>
          <p class="text-[10px] text-stone-200" id="current-user-badge">Operador</p>
        </div>
      </div>
      <div class="flex items-center gap-2 relative">
        <button onclick="toggleNotificationDropdown(event)" class="relative p-1.5 bg-cb-bordo-dark border border-cb-gold/40 rounded-lg text-stone-200 hover:text-white transition text-sm">
          🔔
          <span id="global-notification-dot" class="absolute -top-1.5 -right-1.5 px-1.5 py-0.2 bg-rose-600 text-white rounded-full text-[9px] font-black border border-white hidden">0</span>
        </button>

        <div id="notification-dropdown" class="hidden absolute right-0 top-11 w-72 bg-white text-stone-800 rounded-xl shadow-2xl border border-stone-200 z-50 overflow-hidden">
          <div class="bg-cb-bordo text-white px-3 py-2 text-xs font-bold flex justify-between items-center">
            <div class="flex items-center gap-2">
              <span>Notificações</span>
              <span class="text-[10px] bg-cb-gold text-cb-bordo-dark px-1.5 py-0.2 rounded-full font-bold" id="notif-count-badge">0</span>
            </div>
            <button onclick="clearAllNotifications(event)" class="text-[10px] text-amber-200 hover:underline font-semibold">Limpar Tudo</button>
          </div>
          <div id="notification-list" class="max-h-64 overflow-y-auto divide-y divide-stone-100 text-xs"></div>
        </div>

        <span id="current-module-badge" class="text-[10px] bg-cb-bordo-dark border border-cb-gold/30 px-2 py-1 rounded-full text-cb-gold font-bold uppercase tracking-wider">Checklists</span>
      </div>
    </div>
  </header>

  <div class="app-main p-6 w-full">
    <!-- MÓDULO 1: CHECKLISTS -->
    <div id="module-checklists-container" class="responsive-container w-full">
      <main id="checklist-home-view" class="space-y-4">
        <div class="bg-white p-5 rounded-xl shadow-sm border border-stone-200 space-y-4">
          <h2 class="font-bold text-cb-bordo text-xs uppercase tracking-wider">Selecione o Checklist</h2>
          <div class="space-y-3">
            <select id="home-checklist-select" class="w-full text-xs font-semibold bg-stone-50 border rounded-lg p-3 focus:outline-none focus:ring-1 focus:ring-cb-bordo text-stone-800"></select>
            <button type="button" onclick="startSelectedChecklist()" class="w-full py-3 bg-cb-bordo hover:bg-cb-bordo-dark text-white font-bold text-xs rounded-lg transition uppercase tracking-wider border border-cb-gold/40 shadow-md cursor-pointer">
              Iniciar Checklist
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-2.5">
          <button onclick="switchChecklistTab('history')" class="p-3.5 bg-white hover:bg-stone-50 border border-stone-200 rounded-xl shadow-sm transition flex justify-between items-center text-xs font-bold text-cb-bordo uppercase tracking-wider">
            <span>📂 Relatórios Salvos</span>
            <span id="history-badge-count-main" class="bg-cb-gold text-cb-bordo-dark px-2 py-0.5 rounded-full text-[10px] font-black">0</span>
          </button>
          <button onclick="switchChecklistTab('drafts')" class="p-3.5 bg-white hover:bg-stone-50 border border-stone-200 rounded-xl shadow-sm transition flex justify-between items-center text-xs font-bold text-cb-bordo uppercase tracking-wider">
            <span>📝 Checklists em Andamento (Rascunhos)</span>
            <span id="drafts-badge-count-main" class="bg-cb-gold text-cb-bordo-dark px-2 py-0.5 rounded-full text-[10px] font-black">0</span>
          </button>
          <button id="home-btn-config" onclick="toggleConfigModal()" class="hidden p-3.5 bg-white hover:bg-stone-50 border border-stone-200 rounded-xl shadow-sm transition text-left text-xs font-bold text-cb-bordo uppercase tracking-wider">
            ⚙️ Configurações Gerais dos Checklists
          </button>
        </div>
      </main>

      <main id="audit-view" class="space-y-4 hidden">
        <div class="flex items-center justify-between bg-white p-3 rounded-xl shadow-sm border">
          <button onclick="switchChecklistTab('home')" class="text-xs font-bold text-cb-bordo hover:underline">
            ← Voltar à Seleção
          </button>
          <span id="active-model-title-badge" class="text-xs font-bold text-stone-700">Modelo Atual</span>
        </div>

        <div class="bg-cb-bordo text-white p-3.5 rounded-xl flex justify-between items-center shadow-sm border border-cb-gold/30">
          <div>
            <span class="text-xs font-bold text-stone-200 uppercase tracking-wider block">Conformidade Geral</span>
            <span id="evaluated-count-display" class="text-[10px] text-stone-300">0 avaliados</span>
          </div>
          <span id="score-display" class="text-2xl font-black text-cb-gold">100%</span>
        </div>

        <div class="bg-white p-4 rounded-xl shadow-sm border border-stone-200 space-y-3">
          <div class="flex justify-between items-center border-b pb-2">
            <h2 class="font-bold text-cb-bordo text-xs uppercase tracking-wider">Unidade</h2>
          </div>

          <div class="space-y-3 text-sm">
            <div>
              <label class="block text-xs font-semibold text-stone-600 mb-1">Loja</label>
              <select id="unit-selector" class="w-full border rounded-lg p-2.5 text-sm bg-stone-50 font-semibold text-stone-800" onchange="saveDraft()"></select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-stone-600 mb-1">Supervisor</label>
              <input type="text" id="supervisor-name" class="w-full border rounded-lg p-2.5 text-sm bg-stone-50" oninput="saveDraft()">
            </div>
          </div>
        </div>

        <div id="checklist-container" class="space-y-4"></div>

        <div class="bg-white p-4 rounded-xl shadow-sm border border-stone-200 space-y-2">
          <h2 class="font-bold text-cb-bordo text-xs uppercase tracking-wider">Observações</h2>
          <textarea id="notes" rows="3" placeholder="Comentários..." class="w-full border rounded-lg p-2.5 text-sm bg-stone-50" oninput="saveDraft()"></textarea>
        </div>
      </main>

      <main id="history-view" class="space-y-4 hidden">
        <div class="flex items-center justify-between bg-white p-3 rounded-xl shadow-sm border">
          <button onclick="switchChecklistTab('home')" class="text-xs font-bold text-cb-bordo hover:underline">
            ← Voltar ao Início
          </button>
          <div class="flex gap-2">
            <button onclick="toggleReportsTrashModal()" class="px-3 py-1.5 bg-stone-200 hover:bg-stone-300 text-stone-800 font-bold text-xs rounded-lg transition shadow-sm">
              🗑️ Lixeira de Relatórios (<span id="reports-trash-count">0</span>)
            </button>
            <span class="text-xs font-bold text-stone-700 flex items-center">Relatórios Salvos</span>
          </div>
        </div>

        <div class="bg-white p-4 rounded-xl shadow-sm border border-stone-200 space-y-3">
          <div class="flex justify-between items-center border-b pb-2">
            <h2 class="font-bold text-cb-bordo text-xs uppercase tracking-wider">Filtragem por Período</h2>
          </div>

          <div class="space-y-2 text-xs">
            <div>
              <label class="block font-bold text-stone-600 mb-1">Loja:</label>
              <select id="filter-store" onchange="renderHistoryList()" class="w-full border rounded p-2 bg-stone-50 font-semibold"></select>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block font-bold text-stone-600 mb-1">Data Inicial:</label>
                <input type="date" id="filter-date-start" onchange="renderHistoryList()" class="w-full border rounded p-2 bg-stone-50">
              </div>
              <div>
                <label class="block font-bold text-stone-600 mb-1">Data Final:</label>
                <input type="date" id="filter-date-end" onchange="renderHistoryList()" class="w-full border rounded p-2 bg-stone-50">
              </div>
            </div>
          </div>
        </div>

        <div id="history-list-container" class="space-y-2"></div>
      </main>

      <main id="drafts-view" class="space-y-4 hidden">
        <div class="flex items-center justify-between bg-white p-3 rounded-xl shadow-sm border">
          <button onclick="switchChecklistTab('home')" class="text-xs font-bold text-cb-bordo hover:underline">
            ← Voltar ao Início
          </button>
          <span class="text-xs font-bold text-stone-700">Checklists em Andamento</span>
        </div>
        <div id="drafts-list-container" class="space-y-2"></div>
      </main>
    </div>

    <!-- MÓDULO 2: PLANOS DE AÇÃO & MANUTENÇÃO -->
    <main id="module-actions-container" class="responsive-container space-y-4 hidden w-full">
      <div class="bg-white p-4 rounded-xl shadow-sm border border-stone-200 space-y-3">
        <div class="flex justify-between items-center flex-wrap gap-2">
          <div>
            <h2 class="font-bold text-cb-bordo text-xs uppercase tracking-wider">Agenda de Planos de Ação</h2>
            <p class="text-xs text-stone-500">Acompanhamento e chat com os responsáveis</p>
          </div>
          <div class="flex gap-2">
            <button onclick="toggleTrashModal()" id="btn-trash-actions" class="hidden px-3 py-2 bg-stone-200 hover:bg-stone-300 text-stone-800 font-bold text-xs rounded-lg transition shadow-sm">
              🗑️ Lixeira de Planos (<span id="trash-count">0</span>)
            </button>
            <button onclick="openNewActionModal()" class="px-3 py-2 bg-cb-bordo hover:bg-cb-bordo-dark text-white font-bold text-xs rounded-lg transition shadow-sm">
              + Novo Plano de Ação
            </button>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-2 pt-1 text-center">
          <div onclick="filterActionsByCounter('Pendente')" ondblclick="clearStatusFilter()" class="bg-rose-50 border border-rose-200 p-2.5 rounded-xl shadow-sm cursor-pointer hover:bg-rose-100 transition" title="Clique para filtrar, duplo clique para limpar">
            <span class="block text-[10px] font-bold text-rose-800 uppercase">Pendentes</span>
            <span id="counter-pending" class="text-lg font-black text-rose-700">0</span>
          </div>
          <div onclick="filterActionsByCounter('Em Andamento')" ondblclick="clearStatusFilter()" class="bg-amber-50 border border-amber-200 p-2.5 rounded-xl shadow-sm cursor-pointer hover:bg-amber-100 transition" title="Clique para filtrar, duplo clique para limpar">
            <span class="block text-[10px] font-bold text-amber-900 uppercase">Em Andamento</span>
            <span id="counter-progress" class="text-lg font-black text-amber-700">0</span>
          </div>
          <div onclick="filterActionsByCounter('Concluído')" ondblclick="clearStatusFilter()" class="bg-emerald-50 border border-emerald-200 p-2.5 rounded-xl shadow-sm cursor-pointer hover:bg-emerald-100 transition" title="Clique para filtrar, duplo clique para limpar">
            <span class="block text-[10px] font-bold text-emerald-800 uppercase">Concluídos</span>
            <span id="counter-completed" class="text-lg font-black text-emerald-700">0</span>
          </div>
        </div>

        <div class="flex border-b border-stone-200 text-xs font-bold pt-2">
          <button id="actions-tab-pending" onclick="switchActionsTab('pending')" class="flex-1 py-2 border-b-2 border-cb-bordo text-cb-bordo transition">📋 Pendentes</button>
          <button id="actions-tab-completed" onclick="switchActionsTab('completed')" class="flex-1 py-2 border-b-2 border-transparent text-stone-400 transition">✅ Concluídos</button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-6 gap-2 text-xs pt-1">
          <div>
            <label class="block font-bold text-stone-600 mb-1">Filtrar Loja:</label>
            <select id="filter-action-store" onchange="renderCentralizedActions()" class="w-full border rounded p-2 bg-stone-50 font-semibold">
              <option value="">Todas as Lojas</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-1">Filtrar Status:</label>
            <select id="filter-status" onchange="renderCentralizedActions()" class="w-full border rounded p-2 bg-stone-50 font-semibold">
              <option value="">Todos os Status</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-1">Filtrar Tarja:</label>
            <select id="filter-priority" onchange="renderCentralizedActions()" class="w-full border rounded p-2 bg-stone-50 font-semibold">
              <option value="">Todas as Tarjas</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-1">Tipo de Ação:</label>
            <select id="filter-action-type" onchange="renderCentralizedActions()" class="w-full border rounded p-2 bg-stone-50 font-semibold">
              <option value="">Todos os Tipos</option>
              <option value="nc">Não Conformidade</option>
              <option value="om">Manutenção</option>
              <option value="avulso">Avulso / Manual</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-1">A partir de:</label>
            <input type="date" id="action-date-start" onchange="renderCentralizedActions()" class="w-full border rounded p-2 bg-stone-50">
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-1">Até:</label>
            <input type="date" id="action-date-end" onchange="renderCentralizedActions()" class="w-full border rounded p-2 bg-stone-50">
          </div>
        </div>

        <!-- Barra de Ações em Massa (Batch) -->
        <div id="batch-actions-bar" class="p-2.5 bg-stone-100 rounded-xl border border-stone-200 flex justify-between items-center flex-wrap gap-2 text-xs">
          <div class="flex items-center gap-2">
            <input type="checkbox" id="select-all-actions" onchange="toggleSelectAllActions(this.checked)" class="rounded text-cb-bordo focus:ring-0">
            <label for="select-all-actions" class="font-bold text-stone-700 cursor-pointer">Selecionar Todos</label>
            <span class="text-stone-500">(<span id="selected-actions-count">0</span> selecionados)</span>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="sendWhatsAppFollowUpBatch()" class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded shadow-sm flex items-center gap-1 transition">
              💬 Enviar Follow-up via WhatsApp
            </button>
            <button onclick="deleteSelectedActionsBatch()" id="btn-delete-batch" class="px-3 py-1.5 bg-rose-700 hover:bg-rose-800 text-white font-bold rounded shadow-sm transition">
              🗑️ Excluir Selecionados
            </button>
          </div>
        </div>
      </div>
      <div id="centralized-actions-list" class="space-y-3"></div>
    </main>

    <!-- MÓDULO 3: MANUTENÇÃO & CONTROLE DE GARANTIAS -->
    <main id="module-technicians-container" class="responsive-container space-y-4 hidden w-full">
