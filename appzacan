    function switchChecklistTab(tab) {
      const homeView = document.getElementById("checklist-home-view");
      const auditView = document.getElementById("audit-view");
      const historyView = document.getElementById("history-view");
      const draftsView = document.getElementById("drafts-view");
      const footer = document.getElementById("audit-footer");

      homeView.classList.add("hidden");
      auditView.classList.add("hidden");
      historyView.classList.add("hidden");
      draftsView.classList.add("hidden");
      footer.classList.add("hidden");

      if (tab === 'home') {
        homeView.classList.remove("hidden");
        renderHomeChecklistSelect();
        updateDraftsBadge();
      } else if (tab === 'audit') {
        auditView.classList.remove("hidden");
        footer.classList.remove("hidden");
        updateFooterFinishUI();
      } else if (tab === 'history') {
        historyView.classList.remove("hidden");
        renderHistoryList();
      } else if (tab === 'drafts') {
        draftsView.classList.remove("hidden");
        renderDraftsList();
      }
    }

    function renderHomeChecklistSelect() {
      const select = document.getElementById("home-checklist-select");
      if (!select) return;
      select.innerHTML = "";

      let allowedChecklists = allChecklists.filter(c => {
        if (!c.roles || c.roles.length === 0) return true;
        return c.roles.includes(currentUser?.role);
      });

      if (allowedChecklists.length === 0) {
        select.innerHTML = `<option value="">Nenhum checklist disponível para seu perfil</option>`;
        return;
      }

      allowedChecklists.forEach(c => {
        const opt = document.createElement("option");
        opt.value = c.id;
        opt.innerText = c.name;
        select.appendChild(opt);
      });
      updateDraftsBadge();
    }

    function startSelectedChecklist() {
      const select = document.getElementById("home-checklist-select");
      if (!select || !select.value) return alert("Selecione um checklist válido.");
      activeChecklistId = select.value;
      localStorage.setItem("CB_LOCAL_ACTIVE_ID", activeChecklistId);

      const chk = getCurrentChecklist();
      document.getElementById("active-model-title-badge").innerText = chk ? chk.name : "Checklist";

      customAnswers = {};
      attachedPhotos = {};
      actionPlans = {};
      maintenanceOrders = {};
