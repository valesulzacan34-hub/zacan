    function listenToAllChats() {
      if (!isFirebaseReady) return;
      let allowedUnits = getAllowedUnits();
      let allChatMeta = [];

      savedReports.forEach(rep => {
        if (!allowedUnits.includes(rep.unit)) return;
        rep.nonConformities?.forEach((nc, i) => allChatMeta.push({ chatId: `${rep.id}_nc_${i}`, unit: rep.unit, title: nc.title, reportId: rep.id, actionType: 'nc', index: i, isManual: false }));
        rep.maintenanceOrders?.forEach((om, i) => allChatMeta.push({ chatId: `${rep.id}_om_${i}`, unit: rep.unit, title: om.equipment, reportId: rep.id, actionType: 'om', index: i, isManual: false }));
      });

      manualActionsList.forEach(act => {
        if (allowedUnits.includes(act.unit)) allChatMeta.push({ chatId: act.id, unit: act.unit, title: act.title, reportId: null, actionType: act.type || 'avulso', index: 0, isManual: true });
      });

      allChatMeta.forEach(meta => {
        db.collection("chats").doc(meta.chatId).collection("messages")
          .onSnapshot(snapshot => {
            let hasUnread = false;
            let lastSender = '';
            snapshot.forEach(doc => {
              let m = doc.data();
              if (m.sender !== currentUser?.name && !m.seen) {
                hasUnread = true;
                lastSender = m.sender;
              }
            });
            const dot = document.getElementById(`chat-dot-${meta.chatId}`);
            if (dot) {
              if (hasUnread) dot.classList.remove("hidden");
              else dot.classList.add("hidden");
            }

            if (hasUnread) {
              unreadChatMessages[meta.chatId] = { unit: meta.unit, title: meta.title, sender: lastSender, reportId: meta.reportId, actionType: meta.actionType, index: meta.index, isManual: meta.isManual };
            } else {
              delete unreadChatMessages[meta.chatId];
            }
            localStorage.setItem("CB_UNREAD_CHAT_MSGS", JSON.stringify(unreadChatMessages));
            updateNotificationBadgeCount();
          });
      });
    }

