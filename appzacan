    function renderTechniciansList() {
      const container = document.getElementById("technicians-list-container");
      if (!container) return;
      container.innerHTML = "";

      const regionFilter = document.getElementById("filter-tech-region")?.value || "";
      const serviceFilter = document.getElementById("filter-tech-service")?.value || "";

      const serviceSelect = document.getElementById("filter-tech-service");
      if (serviceSelect && serviceSelect.options.length <= 1) {
        let uniqueServices = [...new Set(techniciansList.map(t => t.service))].sort();
        uniqueServices.forEach(srv => {
          let opt = document.createElement("option");
          opt.value = srv; opt.innerText = srv; serviceSelect.appendChild(opt);
        });
        serviceSelect.value = serviceFilter;
      }

      let filtered = techniciansList.filter(t => {
        let matchReg = !regionFilter || t.region.includes(regionFilter) || t.region === "Geral";
        let matchSrv = !serviceFilter || t.service === serviceFilter;
        return matchReg && matchSrv;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div class="p-8 text-center bg-white rounded-xl border text-stone-400 text-xs">Nenhum técnico encontrado.</div>`;
        return;
      }

      let groups = {};
      filtered.forEach(t => {
        let reg = t.region || "Geral";
        if (!groups[reg]) groups[reg] = [];
        groups[reg].push(t);
      });

      for (let reg in groups) {
