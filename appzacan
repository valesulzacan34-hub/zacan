      uStatus.classList.add("hidden");
      uPriorities.classList.add("hidden");
      btnU.className = "flex-1 py-2.5 border-b-2 border-transparent text-stone-500 transition whitespace-nowrap";
      btnUs.className = "flex-1 py-2.5 border-b-2 border-transparent text-stone-500 transition whitespace-nowrap";
      btnSt.className = "flex-1 py-2.5 border-b-2 border-transparent text-stone-500 transition whitespace-nowrap";
      btnPr.className = "flex-1 py-2.5 border-b-2 border-transparent text-stone-500 transition whitespace-nowrap";

      if (tab === 'units') {
        uContent.classList.remove("hidden");
        btnU.className = "flex-1 py-2.5 border-b-2 border-cb-bordo text-cb-bordo bg-white font-bold transition whitespace-nowrap";
        renderPresetUnits();
      } else if (tab === 'users') {
        uUsers.classList.remove("hidden");
        btnUs.className = "flex-1 py-2.5 border-b-2 border-cb-bordo text-cb-bordo bg-white font-bold transition whitespace-nowrap";
        renderUsersList();
        renderUserUnitsCheckboxes();
      } else if (tab === 'status') {
        uStatus.classList.remove("hidden");
        btnSt.className = "flex-1 py-2.5 border-b-2 border-cb-bordo text-cb-bordo bg-white font-bold transition whitespace-nowrap";
      } else if (tab === 'priorities') {
        uPriorities.classList.remove("hidden");
        btnPr.className = "flex-1 py-2.5 border-b-2 border-cb-bordo text-cb-bordo bg-white font-bold transition whitespace-nowrap";
      }
    }

    function toggleUnitSelectionBox() {
      const role = document.getElementById("new-user-role").value;
      const box = document.getElementById("new-user-units-box");
      if (role === 'admin') box.classList.add("hidden");
      else box.classList.remove("hidden");
    }

    function renderUserUnitsCheckboxes() {
      const select = document.getElementById("new-user-units");
      if (!select) return;
      select.innerHTML = "";
      presetUnits.forEach(u => {
        const opt = document.createElement("option");
        opt.value = u; opt.innerText = u; select.appendChild(opt);
      });
    }

    function renderUsersList() {
      const list = document.getElementById("users-list");
      list.innerHTML = "";
      users.forEach((u, idx) => {
        const item = document.createElement("div");
        item.className = "bg-stone-50 border p-2.5 rounded-xl text-xs space-y-1";
        let unitsText = u.units && u.units.length > 0 ? u.units.join(", ") : "Todas as Lojas";
        item.innerHTML = `
          <div class="flex justify-between items-center">
            <span class="font-bold text-cb-bordo text-sm">${u.name} (${u.role})</span>
            ${u.username !== 'alcides' ? `<button onclick="removeUser(${idx})" class="text-rose-600 font-bold hover:underline">Excluir</button>` : '<span class="text-[10px] text-stone-400 font-bold">Principal</span>'}
          </div>
          <div class="text-stone-500">Login: ${u.username} | Senha: ${u.pass}</div>
          <div class="text-stone-600"><strong>Lojas Vinculadas:</strong> ${unitsText}</div>`;
        list.appendChild(item);
      });
    }

    function addNewUser() {
      const username = document.getElementById("new-user-name").value.trim().toLowerCase();
      const pass = document.getElementById("new-user-pass").value.trim();
      const name = document.getElementById("new-user-fullname").value.trim();
      const role = document.getElementById("new-user-role").value;

      let assignedUnits = [];
      if (role !== 'admin') {
        const select = document.getElementById("new-user-units");
        for (let opt of select.selectedOptions) {
          assignedUnits.push(opt.value);
        }
      }

      if (!username || !pass || !name) return alert("Preencha todos os campos obrigatórios.");
      if (users.some(item => item.username === username)) return alert("Login já existente!");

      users.push({ username, pass, name, role, units: assignedUnits });
      localStorage.setItem("CB_LOCAL_USERS", JSON.stringify(users));
      syncConfigToCloud();

      document.getElementById("new-user-name").value = "";
      document.getElementById("new-user-pass").value = "";
      document.getElementById("new-user-fullname").value = "";
      renderUsersList();
      alert("Usuário criado com sucesso!");
    }

    function removeUser(idx) {
      if (confirm("Excluir este acesso?")) {
        users.splice(idx, 1);
        localStorage.setItem("CB_LOCAL_USERS", JSON.stringify(users));
        syncConfigToCloud();
        renderUsersList();
      }
    }

    function deleteModel(id) {
      if (confirm("Excluir este modelo de checklist?")) {
        allChecklists = allChecklists.filter(c => c.id !== id);
        localStorage.setItem("CB_LOCAL_CHECKLISTS", JSON.stringify(allChecklists));
        syncConfigToCloud();
        renderModelsListInConfig();
      }
    }

    function toggleNewCategoryInput() { document.getElementById("new-cat-box").classList.toggle("hidden"); }
    function getCurrentChecklist() { return allChecklists.find(c => c.id === activeChecklistId) || allChecklists[0]; }

    function createNewChecklistType() {
      const name = document.getElementById("new-checklist-name").value.trim();
      if (!name) return alert("Nome vazio.");

      let selectedRoles = [];
      document.querySelectorAll('input[name="new-chk-role"]:checked').forEach(cb => {
        selectedRoles.push(cb.value);
      });

      if (currentUser?.role === 'gerente') {
        selectedRoles = selectedRoles.filter(r => r === 'gerente' || r === 'operador');
      } else if (currentUser?.role === 'operador') {
        return alert("Operadores não podem criar ou gerenciar modelos de checklist.");
      }

      const newId = "checklist-" + Date.now();
      allChecklists.push({ id: newId, name: name, roles: selectedRoles, categories: [{ category: "1. Itens Gerais", items: [] }] });
      activeChecklistId = newId;
      localStorage.setItem("CB_LOCAL_CHECKLISTS", JSON.stringify(allChecklists));
      localStorage.setItem("CB_LOCAL_ACTIVE_ID", activeChecklistId);
      syncConfigToCloud(); 
      document.getElementById("new-checklist-name").value = "";
      renderModelsListInConfig(); 
      switchConfigTab('items'); 
      alert("Modelo criado com sucesso!");
    }

    function addNewCategory() {
      const catText = document.getElementById("new-cat-text").value.trim();
      if (!catText) return alert("Nome vazio.");
      getCurrentChecklist().categories.push({ category: catText, items: [] });
      localStorage.setItem("CB_LOCAL_CHECKLISTS", JSON.stringify(allChecklists));
      syncConfigToCloud(); document.getElementById("new-cat-text").value = "";
      document.getElementById("new-cat-box").classList.add("hidden"); renderModalItems();
    }

    function addNewItem() {
      const catIdx = document.getElementById("new-item-category").value;
      const itemText = document.getElementById("new-item-text").value.trim();
      if (!itemText) return alert("Digite o título da pergunta.");
      getCurrentChecklist().categories[catIdx].items.push({ title: itemText, type: document.getElementById("new-item-type").value, requirePhoto: document.getElementById("new-item-req-photo").checked });
      localStorage.setItem("CB_LOCAL_CHECKLISTS", JSON.stringify(allChecklists));
      syncConfigToCloud(); document.getElementById("new-item-text").value = ""; renderModalItems();
    }

    function removeItem(sIdx, iIdx) {
      getCurrentChecklist().categories[sIdx].items.splice(iIdx, 1);
      localStorage.setItem("CB_LOCAL_CHECKLISTS", JSON.stringify(allChecklists));
      syncConfigToCloud(); renderModalItems();
    }

    function restoreDefaultChecklist() {
      if (confirm("Restaurar padrões?")) {
        allChecklists = JSON.parse(JSON.stringify(defaultTemplates));
        localStorage.setItem("CB_LOCAL_CHECKLISTS", JSON.stringify(allChecklists));
        syncConfigToCloud(); renderModelsListInConfig(); alert("Restaurado!");
      }
    }

    function resetChecklist() {
      if (confirm("Zerar respostas?")) {
        clearDraft();
        renderChecklist();
      }
    }

    function initApp() {
      updateLogos(); 
      renderPresetUnits(); 
      updateHistoryBadge(); 
      setupCloudListeners();

      if (!currentUser) {
        document.getElementById("login-screen").classList.remove("hidden");
        document.getElementById("modules-screen").classList.add("hidden");
        return;
      }

      document.getElementById("login-screen").classList.add("hidden");
      document.getElementById("sidebar-user-name").innerText = `${currentUser.name} (${currentUser.role})`;
      document.getElementById("supervisor-name").value = currentUser.name;

      if (currentUser.role === "admin" || currentUser.role === "gerente") {
        document.getElementById("home-btn-config").classList.remove("hidden");
        if (currentUser.role === "admin") {
          document.getElementById("sidebar-btn-users").classList.remove("hidden");
        } else {
          document.getElementById("sidebar-btn-users").classList.add("hidden");
        }
      } else {
        document.getElementById("sidebar-btn-users").classList.add("hidden");
        document.getElementById("home-btn-config").classList.add("hidden");
      }

      renderAgendaCalendar();
      openModulesScreen();
    }

    function handleEvaluationChange(itemKey, value) {
      if (isAuditFinished) return;
      customAnswers[itemKey] = value;
      const planBox = document.getElementById(`plan-box-${itemKey}`);
      if (value === "nao-conforme") planBox?.classList.remove("hidden");
      else planBox?.classList.add("hidden");
      calculateScore();
      saveDraft();
    }

    function handleMaintenanceChange(itemKey, value) {
      if (isAuditFinished) return;
      customAnswers[itemKey] = value;
      const omBox = document.getElementById(`maintenance-box-${itemKey}`);
      if (value === "abrir") omBox?.classList.remove("hidden");
      else omBox?.classList.add("hidden");
      calculateScore();
      saveDraft();
    }

    function updateMaintenanceOrder(itemKey, field, val) {
      if (isAuditFinished) return;
      if (!maintenanceOrders[itemKey]) maintenanceOrders[itemKey] = { equipment: '', action: '', date: '' };
      maintenanceOrders[itemKey][field] = val;
      saveDraft();
    }

    function setStarRating(itemKey, stars) {
      if (isAuditFinished) return;
      customAnswers[itemKey] = stars;
      for (let i = 1; i <= 5; i++) {
        const starBtn = document.getElementById(`star-${itemKey}-${i}`);
        if (starBtn) starBtn.className = `text-xl ${i <= stars ? 'text-amber-400 scale-110' : 'text-stone-300'}`;
      }
      const label = document.getElementById(`star-label-${itemKey}`);
      if (label) label.innerText = `${stars} de 5`;
      calculateScore();
      saveDraft();
    }

    function updateTextInput(itemKey, val) {
      if (isAuditFinished) return;
      customAnswers[itemKey] = val;
      saveDraft();
    }

    function updateActionPlan(itemKey, field, val) {
      if (isAuditFinished) return;
      if (!actionPlans[itemKey]) actionPlans[itemKey] = { action: '', date: '' };
      actionPlans[itemKey][field] = val;
      saveDraft();
    }

    function calculateScore() {
      let totalQuestionsEvaluated = 0, pointsEarned = 0;
      getCurrentChecklist().categories.forEach((sec, sIdx) => {
        sec.items.forEach((item, iIdx) => {
          const itemKey = `${sIdx}-${iIdx}`;
          const itemType = item.type || "boolean";
          let ans = customAnswers[itemKey];
          if (itemType === "boolean" && ans) {
            pointsEarned += (ans === "conforme" ? 1.0 : 0.0); totalQuestionsEvaluated += 1.0;
          } else if (itemType === "maintenance" && ans) {
            pointsEarned += (ans === "regular" ? 1.0 : 0.0); totalQuestionsEvaluated += 1.0;
          } else if (itemType === "stars" && ans) {
            let rating = parseInt(ans) || 0;
            if (rating > 0) { pointsEarned += (rating / 5); totalQuestionsEvaluated += 1.0; }
          }
        });
      });
      const score = totalQuestionsEvaluated > 0 ? Math.round((pointsEarned / totalQuestionsEvaluated) * 100) : 100;
      const scoreEl = document.getElementById("score-display");
      const evalEl = document.getElementById("evaluated-count-display");
      if (scoreEl) scoreEl.innerText = score + "%";
      if (evalEl) evalEl.innerText = `${Math.round(totalQuestionsEvaluated)} item(ns) avaliado(s)`;
      return { score, total: Math.round(totalQuestionsEvaluated) };
    }

    function getPhotosArray(key) {
      if (!attachedPhotos[key]) return [];
      if (Array.isArray(attachedPhotos[key])) return attachedPhotos[key];
      return [attachedPhotos[key]];
    }

    function renderChecklist() {
      const container = document.getElementById("checklist-container");
      const current = getCurrentChecklist();
      if (!container) return;
      container.innerHTML = "";

      current.categories.forEach((sec, sIdx) => {
        if (sec.items.length === 0) return;
        const secEl = document.createElement("div");
        secEl.className = "bg-white rounded-xl shadow-sm border border-stone-200 overflow-hidden";

        let itemsHtml = sec.items.map((item, iIdx) => {
          const itemKey = `${sIdx}-${iIdx}`;
          const itemType = item.type || "boolean";
          const photosArr = getPhotosArray(itemKey);
          const planData = actionPlans[itemKey] || { action: '', date: '' };
          const omData = maintenanceOrders[itemKey] || { equipment: '', action: '', date: '' };
          const savedAnswer = customAnswers[itemKey];
          let controlHtml = "";

          if (itemType === "boolean") {
            let isConf = savedAnswer === 'conforme' ? 'checked' : '';
            let isNaoConf = savedAnswer === 'nao-conforme' ? 'checked' : '';
            let isNa = savedAnswer === 'na' ? 'checked' : '';
            let planHidden = savedAnswer === 'nao-conforme' ? '' : 'hidden';

            controlHtml = `
              <div class="flex gap-2 text-xs">
                <label class="flex-1 cursor-pointer"><input type="radio" name="item-${itemKey}" value="conforme" ${isConf} class="hidden peer" onchange="handleEvaluationChange('${itemKey}', 'conforme')"><div class="text-center py-2 rounded-md border peer-checked:bg-emerald-600 peer-checked:text-white font-bold">Sim</div></label>
                <label class="flex-1 cursor-pointer"><input type="radio" name="item-${itemKey}" value="nao-conforme" ${isNaoConf} class="hidden peer" onchange="handleEvaluationChange('${itemKey}', 'nao-conforme')"><div class="text-center py-2 rounded-md border peer-checked:bg-rose-700 peer-checked:text-white font-bold">Não</div></label>
                <label class="flex-1 cursor-pointer"><input type="radio" name="item-${itemKey}" value="na" ${isNa} class="hidden peer" onchange="handleEvaluationChange('${itemKey}', 'na')"><div class="text-center py-2 rounded-md border peer-checked:bg-stone-500 peer-checked:text-white font-bold">N/A</div></label>
              </div>
              <div id="plan-box-${itemKey}" class="${planHidden} p-3 bg-rose-50 border rounded-lg space-y-2 text-xs">
                <span class="block font-bold text-rose-800 uppercase text-[10px]">⚠️ Plano de Ação</span>
                <input type="text" value="${planData.action}" placeholder="Ação..." oninput="updateActionPlan('${itemKey}', 'action', this.value)" class="w-full border p-2 bg-white rounded">
                <input type="date" value="${planData.date}" oninput="updateActionPlan('${itemKey}', 'date', this.value)" class="w-full border p-2 bg-white rounded">
              </div>`;
          } else if (itemType === "maintenance") {
            let isAbrir = savedAnswer === 'abrir' ? 'checked' : '';
            let isReg = savedAnswer === 'regular' ? 'checked' : '';
            let isNa = savedAnswer === 'na' ? 'checked' : '';
            let omHidden = savedAnswer === 'abrir' ? '' : 'hidden';

            controlHtml = `
              <div class="flex gap-2 text-xs">
                <label class="flex-1 cursor-pointer"><input type="radio" name="item-${itemKey}" value="abrir" ${isAbrir} class="hidden peer" onchange="handleMaintenanceChange('${itemKey}', 'abrir')"><div class="text-center py-2 rounded-md border peer-checked:bg-amber-600 peer-checked:text-white font-bold">Abrir</div></label>
                <label class="flex-1 cursor-pointer"><input type="radio" name="item-${itemKey}" value="regular" ${isReg} class="hidden peer" onchange="handleMaintenanceChange('${itemKey}', 'regular')"><div class="text-center py-2 rounded-md border peer-checked:bg-emerald-600 peer-checked:text-white font-bold">Regular / Ok</div></label>
                <label class="flex-1 cursor-pointer"><input type="radio" name="item-${itemKey}" value="na" ${isNa} class="hidden peer" onchange="handleMaintenanceChange('${itemKey}', 'na')"><div class="text-center py-2 rounded-md border peer-checked:bg-stone-500 peer-checked:text-white font-bold">N/A</div></label>
              </div>
              <div id="maintenance-box-${itemKey}" class="${omHidden} p-3 bg-amber-50 border rounded-lg space-y-2 text-xs">
                <span class="block font-bold text-amber-900 uppercase text-[10px]">Abertura de Ordem de Manutenção</span>
                <input type="text" value="${omData.equipment}" placeholder="Equipamento..." oninput="updateMaintenanceOrder('${itemKey}', 'equipment', this.value)" class="w-full border p-2 bg-white rounded">
                <input type="text" value="${omData.action}" placeholder="Defeito..." oninput="updateMaintenanceOrder('${itemKey}', 'action', this.value)" class="w-full border p-2 bg-white rounded">
                <input type="date" value="${omData.date}" oninput="updateMaintenanceOrder('${itemKey}', 'date', this.value)" class="w-full border p-2 bg-white rounded">
              </div>`;
          } else if (itemType === "stars") {
            let currentStars = parseInt(savedAnswer) || 0;
            let starsSpans = "";
            for (let s = 1; s <= 5; s++) starsSpans += `<button type="button" id="star-${itemKey}-${s}" onclick="setStarRating('${itemKey}', ${s})" class="text-xl ${s <= currentStars ? 'text-amber-400' : 'text-stone-300'}">★</button>`;
            controlHtml = `<div class="flex items-center justify-between bg-stone-50 p-2.5 rounded border"><div class="flex gap-2">${starsSpans}</div><span id="star-label-${itemKey}" class="text-xs font-bold">${currentStars ? currentStars + ' de 5' : 'Avalie'}</span></div>`;
          } else if (itemType === "text") {
            controlHtml = `<div><textarea rows="2" placeholder="Digite..." oninput="updateTextInput('${itemKey}', this.value)" class="w-full border p-2 text-xs bg-stone-50 rounded">${savedAnswer || ''}</textarea></div>`;
          }

          let thumbsHtml = photosArr.map((url, pIdx) => `
            <div class="relative inline-block border rounded-lg overflow-hidden bg-white shadow-xs">
              <img src="${url}" onclick="openImageViewer('${url}')" class="h-12 w-12 object-cover cursor-pointer hover:opacity-90" alt="Miniatura">
              <button onclick="removePhotoFromItem('${itemKey}', ${pIdx})" class="absolute top-0 right-0 bg-rose-600 text-white rounded-full w-3.5 h-3.5 flex items-center justify-center text-[9px] font-bold">✕</button>
            </div>
          `).join('');

          return `
          <div class="p-3.5 border-t flex flex-col gap-2.5">
            <div class="flex justify-between items-start gap-2"><span class="text-sm font-medium">${item.title}</span>${item.requirePhoto ? '<span class="text-[10px] bg-amber-50 text-amber-800 border px-1.5 rounded font-bold">Foto Obrigatória</span>' : ''}</div>
            ${controlHtml}
            
            <div class="space-y-1.5 pt-1">
              <div class="flex items-center gap-2">
                <label class="cursor-pointer inline-flex items-center gap-1.5 text-xs font-semibold bg-cb-cream px-3 py-1.5 rounded border">
                  <span>+ Anexar Fotos</span>
                  <input type="file" accept="image/*" multiple class="hidden" onchange="handleMultiplePhotosUpload(event, '${itemKey}')">
                </label>
                <span class="text-xs text-stone-500 font-medium">${photosArr.length} foto(s) anexada(s)</span>
              </div>
              <div class="flex gap-2 flex-wrap">${thumbsHtml}</div>
            </div>
          </div>`;
        }).join("");

        secEl.innerHTML = `<div class="bg-cb-cream px-4 py-2.5 font-bold text-xs uppercase text-cb-bordo border-b"><span>${sec.category}</span></div><div>${itemsHtml}</div>`;
        container.appendChild(secEl);
      });

      calculateScore();
    }

    async function handleMultiplePhotosUpload(event, key) {
      if (isAuditFinished) return;
      const files = event.target.files;
      if (!files || files.length === 0) return;

      if (!attachedPhotos[key] || !Array.isArray(attachedPhotos[key])) {
        attachedPhotos[key] = attachedPhotos[key] ? [attachedPhotos[key]] : [];
      }

      for (let i = 0; i < files.length; i++) {
        try {
          const compressed = await compressImageFile(files[i], 1024, 0.7);
          attachedPhotos[key].push(compressed);
        } catch(e) {
          console.error("Erro ao compactar foto do checklist:", e);
        }
      }

      saveDraft();
      renderChecklist();
    }

    function removePhotoFromItem(key, pIdx) {
      if (isAuditFinished) return;
      if (attachedPhotos[key] && Array.isArray(attachedPhotos[key])) {
        attachedPhotos[key].splice(pIdx, 1);
        if (attachedPhotos[key].length === 0) delete attachedPhotos[key];
        saveDraft();
        renderChecklist();
      }
    }

    function validatePhotos() {
      let missing = [];
      const current = getCurrentChecklist();
      current.categories.forEach((sec, sIdx) => {
        sec.items.forEach((item, iIdx) => {
          const key = `${sIdx}-${iIdx}`;
          const photos = getPhotosArray(key);
          if (item.requirePhoto && photos.length === 0) {
            const isNc = customAnswers[key] === 'nao-conforme';
            const isOm = customAnswers[key] === 'abrir';
            if (isNc || isOm) missing.push(item.title);
          }
        });
      });
      return missing;
    }

    initApp();
  </script>
</body>
</html>
