        renderCentralizedActions();
      } else if (mod === 'technicians') {
        techMod.classList.remove("hidden");
        badgeMod.innerText = "Manutenção";
        renderTechniciansList();
      } else if (mod === 'agenda') {
        if (currentUser.role === 'operador') return alert("Acesso não autorizado para operadores.");
        agendaMod.classList.remove("hidden");
        badgeMod.innerText = "Agenda";

        if (currentUser.role === 'gerente' && currentUser.units && currentUser.units.length > 0) {
          document.getElementById("filter-agenda-store").value = currentUser.units[0];
          document.getElementById("filter-agenda-store").disabled = true;
