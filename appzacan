          let statusBadge = "";

          if (itemType === "boolean") {
            if (ans === 'conforme') statusBadge = '<span style="color: #15803d; font-weight: bold;">☑ SIM</span>';
            else if (ans === 'nao-conforme') statusBadge = '<span style="color: #b91c1c; font-weight: bold;">☑ NÃO</span>';
