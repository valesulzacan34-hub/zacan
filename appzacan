    function triggerUndoToast(desc, type, data) {
      lastDeletedItem = { type, data };
      document.getElementById("undo-text").innerText = `${desc} excluído.`;
      const toast = document.getElementById("undo-toast");
      toast.classList.remove("hidden");
      setTimeout(() => { toast.classList.add("hidden"); }, 7000);
    }

    function executeUndo() {
      if (!lastDeletedItem) return;
      if (lastDeletedItem.type === 'report') {
        if (!savedReports.some(r => r.id === lastDeletedItem.data.id)) {
          savedReports.unshift(lastDeletedItem.data);
          try { localStorage.setItem("CB_LOCAL_REPORTS", JSON.stringify(savedReports)); } catch(e){}
          if (isFirebaseReady) {
            db.collection("reports").doc(lastDeletedItem.data.id).set(lastDeletedItem.data);
          }
        }
      } else if (lastDeletedItem.type === 'event') {
        if (!calendarEvents.some(e => e.id === lastDeletedItem.data.id)) {
          calendarEvents.push(lastDeletedItem.data);
          localStorage.setItem("CB_LOCAL_CALENDAR_EVENTS", JSON.stringify(calendarEvents));
          syncConfigToCloud();
          renderAgendaCalendar();
        }
      } else if (lastDeletedItem.type === 'tech') {
        if (!techniciansList.some(t => t.name === lastDeletedItem.data.name && t.phone === lastDeletedItem.data.phone)) {
          techniciansList.push(lastDeletedItem.data);
          localStorage.setItem("CB_LOCAL_TECHNICIANS", JSON.stringify(techniciansList));
          syncConfigToCloud();
          renderTechniciansList();
        }
      } else if (lastDeletedItem.type === 'manualAction') {
        if (!manualActionsList.some(a => a.id === lastDeletedItem.data.id)) {
          manualActionsList.push(lastDeletedItem.data);
          localStorage.setItem("CB_LOCAL_MANUAL_ACTIONS", JSON.stringify(manualActionsList));
          syncConfigToCloud();
          renderCentralizedActions();
        }
      }
      document.getElementById("undo-toast").classList.add("hidden");
      lastDeletedItem = null;
      renderHistoryList();
      alert("Ação desfeita com sucesso!");
    }

