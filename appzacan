    // CORREÇÃO APLICADA: Tratamento da exceção de Quota Exceeded do LocalStorage
    function saveReportToCloud(reportData) {
      if (!savedReports.some(r => r.id === reportData.id)) {
        savedReports.unshift(reportData);
      }

      try {
        localStorage.setItem("CB_LOCAL_REPORTS", JSON.stringify(savedReports));
      } catch (e) {
        console.warn("Aviso: LocalStorage excedeu o limite de quota. O relatório foi mantido na memória/Firestore.", e);
      }

      updateHistoryBadge();
      updateNotificationBadgeCount();
      renderHistoryList();

      if (isFirebaseReady) {
        reportData.createdAt = firebase.firestore.FieldValue.serverTimestamp();
        db.collection("reports").doc(reportData.id).set(reportData).then(() => {
          renderHistoryList();
        }).catch(err => console.error("Erro ao salvar relatório no Firestore:", err));
      }
    }

    function switchActionsTab(tab) {
      currentActionsTab = tab;
      selectedActionIds.clear();
      updateSelectedActionsCount();
